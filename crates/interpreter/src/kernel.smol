"ValueHolder - an actor that holds a single mutable value reference"
Object subclass: #ValueHolder instanceVariableNames: 'val'.
ValueHolder class >> initialValue: aVal [
    ^ValueHolder new set: aVal; yourself
]
ValueHolder >> set: aVal [ val := aVal ]
ValueHolder >> get [ ^val ]
"Takes aBlock that accepts the old value and returns an updated value"
ValueHolder >> update: aBlock [
    self set: (aBlock value: self get)
]

"Array — fixed-size indexed collection of pointer slots."
Object subclass: #Array
    instanceVariableNames: ''
    classVariableNames: ''
    indexedSlots: #pointer.

Array >> at: i       [ ^self _primAt: i ]
Array >> at: i put: v [ self _primAt: i put: v. ^v ]
Array >> size        [ ^self _primSize ]
Array >> isEmpty     [ ^self _primSize = 0 ]
Array >> notEmpty    [ ^self _primSize > 0 ]
Array >> first       [ ^self _primAt: 0 ]
Array >> last        [ ^self _primAt: self _primSize - 1 ]

Array >> do: aBlock [
    0 to: (self _primSize - 1) do: [ :i |
        aBlock value: (self _primAt: i)
    ]
]

Array >> collect: aBlock [
    | result |
    result := Array new: self _primSize.
    0 to: (self _primSize - 1) do: [ :i |
        result at: i put: (aBlock value: (self _primAt: i))
    ]
    ^result
]

Array >> select: aBlock [
    | result |
    result := OrderedCollection new.
    self do: [:each | (aBlock value: each) ifTrue: [result add: each]].
    ^result
]

Array >> reject: aBlock [
    | result |
    result := OrderedCollection new.
    self do: [:each | (aBlock value: each) ifFalse: [result add: each]].
    ^result
]

Array >> detect: aBlock [
    self do: [:each | (aBlock value: each) ifTrue: [^each]].
    self error: 'detect: no element satisfies the condition'
]

Array >> detect: aBlock ifNone: noneBlock [
    self do: [:each | (aBlock value: each) ifTrue: [^each]].
    ^noneBlock value
]

Array >> inject: init into: aBlock [
    | holder |
    holder := ValueHolder initialValue: init.
    ^[self do: [:each |
        holder update: [:acc | aBlock value: acc value: each]
    ]] then: [:done | holder get] orElse: #reject
]

Array >> includes: v [
    self do: [:each | each = v ifTrue: [^true]].
    ^false
]

"The HALF-OPEN form is the implementation and the inclusive one derives from it
(C34 S3a). That direction is Dijkstra's point (EWD831) made concrete: a half-open
copy needs no adjustment at all — the length IS `stop - start` — whereas writing
the inclusive form directly forces a `+ 1` for the length and a `- 1` for the loop
bound. Deriving the cheap form from the expensive one would have made `until:` pay
for `to:`; this way each form costs what it inherently needs (`until:` one
subtraction, `to:` that plus one addition), and both are cheaper than the inclusive
implementation this replaced. `copyFrom: i until: j` takes `j - i` elements, so an
empty copy is `i = j` and adjacent slices share a bound."
Array >> copyFrom: start until: stop [
    | result n |
    n := stop - start.
    result := Array new: n.
    0 until: n do: [:i |
        result at: i put: (self _primAt: start + i)
    ].
    ^result
]

Array >> copyFrom: start to: stop [ ^self copyFrom: start until: stop + 1 ]

Array >> = other [
    | n |
    self class = other class ifFalse: [^false].
    n := self _primSize.
    n = other size ifFalse: [^false].
    0 to: n - 1 do: [ :i |
        (self _primAt: i) = (other at: i) ifFalse: [^false].
    ].
    ^true
]

Array >> ~= other [ ^(self = other) not ]

Array >> asString [
    | holder |
    holder := ValueHolder initialValue: '('.
    ^[self do: [:each |
        holder update: [:s | s , each asDebugString , ' ']
    ]] then: [:done | holder get , ')'] orElse: #reject
]

"ByteArray — fixed-size indexed collection of byte (0..255) slots."
Object subclass: #ByteArray
    instanceVariableNames: ''
    classVariableNames: ''
    indexedSlots: #byte.

ByteArray >> at: i       [ ^self _primAt: i ]
ByteArray >> at: i put: v [ self _primAt: i put: v. ^v ]
ByteArray >> size        [ ^self _primSize ]
ByteArray >> isEmpty     [ ^self _primSize = 0 ]
ByteArray >> notEmpty    [ ^self _primSize > 0 ]

ByteArray >> do: aBlock [
    0 to: self _primSize - 1 do: [:i |
        aBlock value: (self _primAt: i)
    ]
]

ByteArray >> copyFrom: start until: stop [
    | result n |
    n := stop - start.
    result := ByteArray new: n.
    0 until: n do: [:i |
        result at: i put: (self _primAt: start + i)
    ].
    ^result
]
ByteArray >> copyFrom: start to: stop [ ^self copyFrom: start until: stop + 1 ]

ByteArray >> asString [ ^self _primAsString ]

ByteArray >> asDebugString [
    | holder |
    holder := ValueHolder initialValue: '('.
    ^[self do: [:each |
        holder update: [:s | s , each asDebugString , ' ']
    ]] then: [:done | holder get , ')'] orElse: #reject
]

"OrderedCollection — growable sequence backed by an Array."
Object subclass: #OrderedCollection
    instanceVariableNames: 'storage size'
    classVariableNames: ''
    indexedSlots: #none.

OrderedCollection >> initialize [
    storage := Array new: 8.
    size := 0
]

OrderedCollection >> size        [ ^size ]
OrderedCollection >> isEmpty     [ ^size = 0 ]
OrderedCollection >> notEmpty    [ ^size > 0 ]
OrderedCollection >> first       [ ^self at: 0 ]
OrderedCollection >> last        [ ^self at: size - 1 ]

OrderedCollection >> at: i [
    (i < 0 or: [i >= size]) ifTrue: [self error: 'at: index out of bounds'].
    ^storage at: i
]

OrderedCollection >> at: i put: v [
    (i < 0 or: [i >= size]) ifTrue: [self error: 'at:put: index out of bounds'].
    storage at: i put: v.
    ^v
]

OrderedCollection >> add: v [
    size >= storage size ifTrue: [self pvtGrow].
    storage at: size put: v.
    size := size + 1.
    ^v
]

OrderedCollection >> addLast: v [ ^self add: v ]

OrderedCollection >> addFirst: v [
    size >= storage size ifTrue: [self pvtGrow].
    size to: 1 by: -1 do: [:i |
        storage at: i put: (storage at: i - 1)
    ].
    storage at: 0 put: v.
    size := size + 1.
    ^v
]

OrderedCollection >> removeFirst [
    | v |
    size = 0 ifTrue: [self error: 'removeFirst: collection is empty'].
    v := storage at: 0.
    1 to: size - 1 do: [:i |
        storage at: i - 1 put: (storage at: i)
    ].
    size := size - 1.
    ^v
]

OrderedCollection >> removeLast [
    | v |
    size = 0 ifTrue: [self error: 'removeLast: collection is empty'].
    v := storage at: size - 1.
    size := size - 1.
    ^v
]

OrderedCollection >> pvtRemoveAt: idx [
    idx + 1 to: size - 1 do: [:j |
        storage at: j - 1 put: (storage at: j)
    ].
    size := size - 1
]

OrderedCollection >> remove: v ifAbsent: aBlock [
    0 to: size - 1 do: [:i |
        (storage at: i) = v ifTrue: [
            (self pvtRemoveAt: i) then: [:done | ^v] orElse: #reject
        ]
    ].
    ^aBlock value
]

OrderedCollection >> do: aBlock [
    0 to: size - 1 do: [:i |
        aBlock value: (storage at: i)
    ]
]

OrderedCollection >> collect: aBlock [
    | result |
    result := OrderedCollection new.
    0 to: size - 1 do: [:i |
        result add: (aBlock value: (storage at: i))
    ].
    ^result
]

OrderedCollection >> select: aBlock [
    | result |
    result := OrderedCollection new.
    self do: [:each | (aBlock value: each) ifTrue: [result add: each]].
    ^result
]

OrderedCollection >> reject: aBlock [
    | result |
    result := OrderedCollection new.
    self do: [:each | (aBlock value: each) ifFalse: [result add: each]].
    ^result
]

OrderedCollection >> detect: aBlock [
    self do: [:each | (aBlock value: each) ifTrue: [^each]].
    self error: 'detect: no element satisfies the condition'
]

OrderedCollection >> detect: aBlock ifNone: noneBlock [
    self do: [:each | (aBlock value: each) ifTrue: [^each]].
    ^noneBlock value
]

OrderedCollection >> inject: init into: aBlock [
    | holder |
    holder := ValueHolder initialValue: init.
    ^[self do: [:each |
        holder update: [:acc | aBlock value: acc value: each]
    ]] then: [:done | holder get] orElse: #reject
]

OrderedCollection >> includes: v [
    self do: [:each | each = v ifTrue: [^true]].
    ^false
]

"Here the half-open form needs NO adjustment arithmetic whatsoever — `start until:
stop do:` is already exactly the range to copy."
OrderedCollection >> copyFrom: start until: stop [
    | result |
    result := OrderedCollection new.
    start until: stop do: [:i |
        result add: (self at: i)
    ].
    ^result
]
OrderedCollection >> copyFrom: start to: stop [ ^self copyFrom: start until: stop + 1 ]

OrderedCollection >> = other [
    self class = other class ifFalse: [^false].
    size = other size ifFalse: [^false].
    0 to: size - 1 do: [:i |
        (self at: i) = (other at: i) ifFalse: [^false]
    ].
    ^true
]

OrderedCollection >> ~= other [ ^(self = other) not ]

OrderedCollection >> asString [
    | holder |
    holder := ValueHolder initialValue: 'OrderedCollection ('.
    ^[self do: [:each |
        holder update: [:s | s , each asDebugString , ' ']
    ]] then: [:done | holder get , ')'] orElse: #reject
]

OrderedCollection >> pvtGrow [
    | newStorage |
    newStorage := Array new: storage size * 2.
    0 to: size - 1 do: [:i |
        newStorage at: i put: (storage at: i)
    ].
    storage := newStorage
]


"Identity and equality (plan chunk_34 §6 OQ-3, S2). Pharo's shape: `==` is the
identity PRIMITIVE and `=` is defined in terms of it, so the default equality of
every object has one implementation instead of a per-variant Rust arm each for
Nil, Symbol, String, Class and instances. A class needing domain equality
overrides `=` (Number, Array, OrderedCollection, Dictionary, Association, True,
False all do); `==` is not meant to be overridden.

WHAT `==` MEANS HERE — decided rather than inherited by accident. It is O(1)
indistinguishability, and what that amounts to depends on how the receiver is
represented:

  - An ENCODED SCALAR (integers, Float, Bool, nil, Symbol, String) has no
    identity apart from its content — the encoding IS the value — so `==` is
    structural. `'abc' == 'abc'` is TRUE, where Pharo answers false because two
    String objects are two allocations. Pharo's answer is an artifact of
    everything being a heap object; ours follows from the Value/Object split.
    The two integer encodings cross-compare (a MachineInteger and an
    ArbitraryInteger denoting the same integer are `==`), because they are two
    encodings of one value. Float does NOT cross-compare with the integers:
    `2 == 2.0` is false — they are different values, one exact and one not.
    (`2 = 2.0` is TRUE; `Number >> =` promotes. `=` and `==` part company here,
    which is exactly why both exist.)

  - Anything with a heap identity — an Object entity, a Block, a Future, a
    Namespace, and ALSO a ValueObject — compares as the same allocation. Note
    the ValueObject case: two structurally-equal Associations are NOT `==`,
    even though an Association is semantically a Value. `==` stays constant
    time and does not recurse; deep content equality is `=`'s job, which is
    why Association overrides it.

`~=` is derived once here so it can never contradict `=`, which is how the
numeric `~=` arms nearly went wrong in the tower's S6.

`~~` completes the pair. The lexer already produced a `~~` token before S2, but
nothing implemented it, so `a ~~ b` could only ever answer doesNotUnderstand."
Object >> == other [ ^self _primIdentical: other ]
Object >> ~~ other [ ^(self == other) not ]
Object >> =  other [ ^self == other ]
Object >> ~= other [ ^(self = other) not ]

"── Rendering and console output (plan chunk_34 §6 OQ-4, S5) ─────────────────

`printString` is GONE. It was misnamed — it rendered rather than printed — and its
Rust arms carried a `println!` that was the language's only output channel, which
made every rendering send write to the console as a side effect. That side effect
was not even consistent (4 of 9 arms had it, and the 9 Smol-defined ones could not),
and worse, it LEAKED COMPOSITIONALLY: `Duration >> printString` is
`^ms printString , 'ms'`, so rendering a Duration emitted a stray line for its
milliseconds, and rendering an Association emitted two.

Rendering and printing are now separate, and both are ordinary Smol.

TWO RENDERINGS, because one is not enough. `asString` answers the BARE text — what
the receiver looks like as a string, suitable for building a message or writing to a
socket. `asDebugString` answers the DISAMBIGUATING text, which is what you want when
a human is reading it and needs to tell `3` from `'3'`, or `#hi` from `'hi'`. They
differ only where a bare rendering would be ambiguous — String and Symbol — so
everything else inherits `asDebugString` from `Object` and answers the same for both.
Collections render their ELEMENTS with `asDebugString` for exactly this reason.

`print` / `printNl` write `asString` — the bare form — and `Nl` is the newline, not a
different rendering. Bare is the only non-circular choice: if printing decorated were
the default there would be no way to print a plain string, since converting first and
then printing would decorate the result again. Decorated output is therefore
conversion-first, which composes: `x asDebugString printNl`.

The write primitives live on String rather than Object because a `_prim` may only be
sent to `self`; `Object >> print` converts and delegates to `String >> print`. Both
answer `self`, so printing chains."

Object >> asString      [ ^self _primAsString ]
Object >> asDebugString [ ^self asString ]

Object >> print   [ self asString print.   ^self ]
Object >> printNl [ self asString printNl. ^self ]

"Default hash delegates to _primHash (identity-based pointer hash).
 Subclasses that override = for value equality must also override hash
 to maintain the invariant: a = b → a hash = b hash."
Object >> hash [ ^self _primHash ]

"Default initialize is a no-op."
Object >> initialize []

"Default isEmpty returns false; collection subclasses override."
Object >> isEmpty [ ^false ]

Object >> class [ ^self _primClass ]
Object >> isKindOf: aClass [ ^self _primIsKindOf: aClass ]

"Marks an abstract method that a concrete subclass must supply. Signals rather
than returning nil so a missing override fails loudly at the point of use."
Object >> subclassResponsibility [
    ^Error signal: self class name, ' must implement this method (subclass responsibility)'
]

"Default handling of a send that failed normal lookup: signal a
MessageNotUnderstood condition carrying the reified message. Override in a
subclass to intercept/forward arbitrary messages (proxies, transparent futures).
The interpreter invokes this via the DNU hook in dispatch_to_stack /
dispatch_envelope; see docs/chunk_33_plan.md."
Object >> doesNotUnderstand: aMessage [
    ^(MessageNotUnderstood receiver: self message: aMessage) signal
]

Object class >> new [
    ^[self _primNew initialize] syncValue
]

Object class >> new: n [
    ^[(self _primNew: n) initialize] syncValue
]

"Value class >> new freezes the instance after initialize."
Value class >> new [
    ^self _primNewValue: [:inst | inst initialize]
]

Value class >> new: n [
    ^self _primNewValueIndexed: n init: [:inst | inst initialize]
]

"Association — immutable key / mutable value pair."
Value subclass: #Association
    instanceVariableNames: 'key value'
    classVariableNames: ''
    indexedSlots: #none.

Association class >> key: k value: v [
    ^self _primNewValue: [:a | a pvtKey: k value: v]
]

Association >> pvtKey: k value: v [ key := k. value := v ]
Association >> key      [ ^key ]
Association >> value    [ ^value ]
Association >> value: v [ ^self class key: key value: v ]
Association >> = other [
    self class = other class ifFalse: [^false].
    ^key = other key
]
Association >> asString [
    ^key asDebugString , ' -> ' , value asDebugString
]

"Shorthand for building Associations via binary message -> ."
Object >> -> aVal [ ^Association key: self value: aVal ]

"Trait — a stateless, first-class unit of behavioral reuse (docs/traits_plan.md).
 The `data` ivar holds the native TraitData payload (method dict + provenance).
 The +/-/@ algebra builds fresh traits; requirements are derived from method bodies."
Value subclass: #Trait
    instanceVariableNames: 'data'
    classVariableNames: ''
    indexedSlots: #none.

"Create an empty named trait; extend it with `aTrait >> selector [...]`."
Trait class >> named: n [ ^self _primNewTrait: n ]

"Name a trait built from a composition expression; binds the name in scope."
Trait class >> named: n from: aTrait [ ^self _primDefineTrait: n from: aTrait ]

"Sum / union. Conflicting selectors (differing provenance) become conflict markers."
Trait >> + other [ ^self _primTraitSum: other ]

"Exclusion. Right operand is polymorphic: a Trait (drop its provided selectors)
 or an Array of Symbols (drop that explicit selector set)."
Trait >> - arg [
    (arg isKindOf: Trait) ifTrue: [^self _primTraitExcludeTrait: arg].
    ^self _primTraitExcludeSelectors: arg
]

"Aliasing: add entry points. Argument is an Array of Associations #newSel -> #oldSel."
Trait >> @ aliases [ ^self _primTraitAlias: aliases ]

Trait >> name          [ ^self _primTraitName ]
Trait >> requirements  [ ^self _primTraitRequirements ]
Trait >> conflicts     [ ^self _primTraitConflicts ]
Trait >> asString      [ ^'Trait(' , self _primTraitName asDebugString , ')' ]

"Cons — immutable singly-linked list node.
 nil is the empty list; isNil / isEmpty are the emptiness checks."
Value subclass: #Cons
    instanceVariableNames: 'head tail'
    classVariableNames: ''
    indexedSlots: #none.

Cons class >> with: anObject rest: aList [
    ^self _primNewValue: [:c |
        c pvtHead: anObject tail: aList.
    ]
]

Cons class >> singleton: anObject [
    ^self _primNewValue: [:c |
        c pvtHead: anObject tail: nil.
    ]
]

Cons >> pvtHead: h tail: t [ head := h. tail := t. ]
Cons >> head           [ ^head ]
Cons >> tail           [ ^tail ]
Cons >> isEmpty        [ ^false ]

Cons >> addFirst: x [ ^Cons with: x rest: self ]

Cons >> do: aBlock [
    aBlock value: head.
    tail isNil ifFalse: [tail do: aBlock]
]

Cons >> size [
    ^1 + (tail isNil ifTrue: [0] ifFalse: [tail size])
]

"nil renders as itself; the Rust arm that used to do this went with the rest of
the printString family in S5."
Nil >> asString [ ^'nil' ]

Nil >> isEmpty [ ^true ]
Nil >> do: aBlock [ ^nil ]
Nil >> inject: aValue into: aBlock [ ^aValue ]

Cons >> inject: aValue into: aBlock [
    ^tail inject: (aBlock value: aValue value: head) into: aBlock
]

"Message — a reified send: the selector and arguments of a message that failed
 normal lookup, handed to `doesNotUnderstand:`. Constructed by the interpreter at
 the DNU site (see build_message in eval_iterative.rs); `arguments` is a Cons list
 (nil for a unary/0-arg send). A Value so it is immutable and freely shareable."
Value subclass: #Message
    instanceVariableNames: 'selector arguments'
    classVariableNames: ''
    indexedSlots: #none.

Message >> selector       [ ^selector ]
Message >> arguments      [ ^arguments ]
Message >> argumentCount  [ ^arguments isNil ifTrue: [0] ifFalse: [arguments size] ]
Message >> sendTo: anObject [ ^anObject perform: selector withArguments: arguments ]

"Dictionary — open-addressing hash map over a flat Array of Association slots.
 Initial capacity 8; rehashes at 75% load by doubling."
Object subclass: #Dictionary
    instanceVariableNames: 'table size'
    classVariableNames: ''
    indexedSlots: #none.

Dictionary >> initialize [
    table := Array new: 8.
    size := 0
]

"Returns the slot index for key — nil slot means absent, matching slot means present."
Dictionary >> pvtSlotFor: key [
    | cap h i |
    cap := table size.
    h := key hash \\ cap.
    i := h < 0 ifTrue: [h + cap] ifFalse: [h].
    i to: (i + table size - 1) do: [ :i | 
        |slot j|
        j := i \\ cap. 
        slot := table at: j.
        (slot isNil or: [slot key = key]) ifTrue: [^j]
    ]
]

Dictionary >> at: key put: value [
    | i slot |
    (size * 4) >= (table size * 3) ifTrue: [self pvtRehash].
    i := self pvtSlotFor: key.
    slot := table at: i.
    size := slot isNil
        ifTrue: [
            table at: i put: (Association key: key value: value).
            size + 1]
        ifFalse: [
            table at: i put: (Association key: key value: value).
            size].
    ^value
]

Dictionary >> at: key [
    ^self at: key ifAbsent: [Error signal: 'key not found']
]

Dictionary >> at: key ifAbsent: aBlock [
    | i slot |
    i := self pvtSlotFor: key.
    slot := table at: i.
    slot isNil ifTrue: [^aBlock value].
    ^slot value
]

Dictionary >> includesKey: key [
    | slot |
    slot := table at: (self pvtSlotFor: key).
    ^slot notNil
]

"Removes key; returns value if present, block result if absent.
 Uses full-table rebuild to preserve open-addressing invariants."
Dictionary >> removeKey: key ifAbsent: aBlock [
    | i slot removedValue oldTable oldSize |
    i := self pvtSlotFor: key.
    slot := table at: i.
    slot isNil ifTrue: [^aBlock value].
    removedValue := slot value.
    oldTable := table.
    oldSize := oldTable size.
    table := Array new: oldSize.
    size := 0.
    0 to: oldSize - 1 do: [:i |
        (oldTable at: i) ifNotNil: [:s |
            (s key ~= key) ifTrue: [self at: s key put: s value]
        ]
    ].
    ^removedValue
]

Dictionary >> size     [ ^size ]
Dictionary >> isEmpty  [ ^size = 0 ]
Dictionary >> notEmpty [ ^size > 0 ]

Dictionary >> do: aBlock [
    | cap |
    cap := table size.
    0 to: cap - 1 do: [:i |
        (table at: i) ifNotNil: [:slot | aBlock value: slot value]
    ]
]

Dictionary >> keysDo: aBlock [
    | cap |
    cap := table size.
    0 to: cap - 1 do: [:i |
        (table at: i) ifNotNil: [:slot | aBlock value: slot key]
    ]
]

Dictionary >> associationsDo: aBlock [
    | cap |
    cap := table size.
    0 to: cap - 1 do: [:i |
        (table at: i) ifNotNil: [:slot | aBlock value: slot]
    ]
]

Dictionary >> keys [
    | result |
    result := OrderedCollection new.
    self keysDo: [:k | result add: k].
    ^result
]

Dictionary >> values [
    | result |
    result := OrderedCollection new.
    self do: [:v | result add: v].
    ^result
]

Dictionary >> = other [
    self class = other class ifFalse: [^false].
    size = other size ifFalse: [^false].
    self associationsDo: [:assoc |
        (other at: assoc key ifAbsent: [^false]) = assoc value
            ifFalse: [^false]
    ].
    ^true
]

Dictionary >> asString [
    | holder |
    holder := ValueHolder initialValue: 'Dictionary ('.
    ^[self associationsDo: [:assoc |
        holder update: [:s | s , assoc asDebugString , ' ']
    ]] then: [:done | holder get , ')'] orElse: #reject
]

Dictionary >> pvtRehash [
    | old |
    old := table.
    table := Array new: old size * 2.
    size := 0.
    0 to: old size - 1 do: [:i |
        (old at: i) ifNotNil: [:slot | self at: slot key put: slot value]
    ]
]

"Condition hierarchy — CL-inspired non-local condition/restart system."

Value subclass: #Condition
    instanceVariableNames: 'message restarts'
    classVariableNames: ''
    indexedSlots: #none.

Condition class >> withMessage: aString [
    ^self _primNewValue: [:c |
        c pvtSetMessage: aString
    ]
]

"Factory for functional updates: preserves polymorphism across Condition subclasses."
Condition class >> pvtMessage: msg restarts: r [
    ^self _primNewValue: [:c |
        c pvtSetMessage: msg.
        c pvtSetRestarts: r
    ]
]

Condition class >> signal: aString [ ^(self withMessage: aString) signal ]

"restarts is a Cons-of-Association (or nil). Frozen after construction."
Condition >> initialize         [ message := '' ]
Condition >> pvtSetMessage: s   [ message := s ]
Condition >> pvtSetRestarts: r  [ restarts := r ]
Condition >> message            [ ^message ]
Condition >> messageText        [ ^message ]

"Returns a new Condition with this restart prepended; self is unchanged (frozen)."
Condition >> addRestart: name block: aBlock [
    ^self class pvtMessage: message restarts: (Cons with: (name -> aBlock) rest: restarts)
]

Condition >> pvtFindRestart: name in: node [
    node isNil ifTrue: [^nil].
    node head key = name ifTrue: [^node head value].
    ^self pvtFindRestart: name in: node tail
]

Condition >> hasRestart: name [ ^(self pvtFindRestart: name in: restarts) notNil ]
Condition >> availableRestarts [ ^#() ]

"Run the named restart block, passing it the condition so it may perform its own
transfer (`c return:` / `c resume:` / `c retry`). A transfer unwinds before the
enclosing `resume:` runs, so the block's choice wins; a block that completes
normally defaults to resuming with its value."
Condition >> invokeRestart: name [
    | blk |
    blk := self pvtFindRestart: name in: restarts.
    blk isNil ifTrue: [self error: 'no restart named: ', name].
    ^self resume: (blk value: self)
]

Condition >> invokeRestart: name with: arg [
    | blk |
    blk := self pvtFindRestart: name in: restarts.
    blk isNil ifTrue: [self error: 'no restart named: ', name].
    ^self resume: (blk value: self value: arg)
]

Condition >> signal    [ ^self _primSignalCondition: self ]
Condition >> resume: v [ ^self _primResume: v ]
Condition >> return: v [ ^self _primReturn: v ]
Condition >> retry     [ ^self _primRetry ]

"Resumability (guide §2): whether a handler that completes without an explicit
restart resumes (true) or aborts (false). This is a *class-level* policy keyed on
the class named at the handler site (`on: SomeClass do:` / `HandlerContext on:
SomeClass do:`), NOT the concrete class of the signalled instance — so a handler
declared for `Error` always aborts, even for a resumable `Error` subclass. The
signal machinery reads this class-side predicate (constant-folded, so it must
return a literal `true`/`false`). `Condition` is resumable; `Error` overrides to
non-resumable. The instance-side method delegates for Smol ergonomics."
Condition class >> isResumable [ ^true ]
Condition >> isResumable       [ ^self class isResumable ]

Condition subclass: #Warning
    instanceVariableNames: ''
    classVariableNames: 'LoggingPolicy'
    indexedSlots: #none.

Warning class >> initialize         [ LoggingPolicy := #stderr ]
Warning class >> loggingPolicy: sym [ LoggingPolicy := sym ]
Warning class >> loggingPolicy      [ ^LoggingPolicy ]

Condition subclass: #Error
    instanceVariableNames: ''
    classVariableNames: ''
    indexedSlots: #none.

Error class >> isResumable [ ^false ]

"Signaled when resolveWith:/rejectWith: is sent to an already-settled Future.
Carries an #ignore restart so a handler can choose to keep the first resolution."
Error subclass: #FutureAlreadyResolved
    instanceVariableNames: ''
    classVariableNames: ''
    indexedSlots: #none.

"Signaled by the default Object>>doesNotUnderstand: when a send fails normal
lookup. Carries the receiver and the reified failed Message. A handler may
`resume:` (or `return:`) a value to substitute for the failed send's result."
Error subclass: #MessageNotUnderstood
    instanceVariableNames: 'receiver failedMessage'
    classVariableNames: ''
    indexedSlots: #none.

MessageNotUnderstood class >> receiver: r message: m [
    ^self _primNewValue: [:c | c pvtSetReceiver: r message: m]
]

MessageNotUnderstood >> pvtSetReceiver: r message: m [
    receiver := r.
    failedMessage := m.
    self pvtSetMessage: 'does not understand #', m selector asString
]

MessageNotUnderstood >> receiver      [ ^receiver ]
MessageNotUnderstood >> failedMessage [ ^failedMessage ]

"Signaled (by the interpreter's deadlock detector, C31 S5c) inside a transaction
coordinator whose participants are caught in a wait-for cycle. Being an Error, it
is caught by the transaction's `on: Error do:` handler, which rolls back and
releases the victim's locks so the rest of the cycle proceeds."
Error subclass: #Deadlock
    instanceVariableNames: ''
    classVariableNames: ''
    indexedSlots: #none.

"Signaled when a class inherits an unresolved trait conflict (two composed traits
provide the same selector with differing provenance) and that selector is sent
without a class-defined override. Carries the offending selector."
Error subclass: #TraitConflict
    instanceVariableNames: 'selector'
    classVariableNames: ''
    indexedSlots: #none.

TraitConflict class >> selector: sel [
    ^self _primNewValue: [:c | c pvtSetSelector: sel]
]
TraitConflict >> pvtSetSelector: sel [
    selector := sel.
    self pvtSetMessage: 'unresolved trait conflict: #', sel asString
]
TraitConflict >> selector [ ^selector ]

"Signaled when an arithmetic operation cannot bridge two numeric domains: the argument
does not implement the receiver's adapt selector, so neither operand can express the
operation (docs/numeric_tower_plan.md §4g). Carries BOTH operands intact plus the
arithmetic selector — the whole point of asking before sending is that neither side has
been projected away by the time this is raised, so a handler can inspect what actually
failed to coerce. Replaces the untyped `self error:` the refusing defaults used, which
a handler could not distinguish from any other Error.

Non-resumable (an Error). A `use-value`-style restart letting a handler supply the
coerced result is a natural later addition, deferred until a caller wants one."
Error subclass: #NoCoercion
    instanceVariableNames: 'receiver argument selector'
    classVariableNames: ''
    indexedSlots: #none.

NoCoercion class >> receiver: r argument: a selector: sel [
    ^self _primNewValue: [:c | c pvtSetReceiver: r argument: a selector: sel]
]

NoCoercion >> pvtSetReceiver: r argument: a selector: sel [
    receiver := r.
    argument := a.
    selector := sel.
    self pvtSetMessage: 'cannot coerce ', a asDebugString, ' to a number for ', sel asString
]

NoCoercion >> receiver [ ^receiver ]
NoCoercion >> argument [ ^argument ]
NoCoercion >> selector [ ^selector ]

"Sentinel entry point installed for an unresolved trait conflict; raises when sent."
Object >> pvtTraitConflictFor: sel [ ^(TraitConflict selector: sel) signal ]

"HandlerContext — non-unwinding handler registration (CL handler-bind analog).
pairs is a Cons-of-Association linked list (or nil):
  Cons(head: cls -> blk, tail: rest)
Newest pair is at the head.

HandlerContext is a Value (synchronous dispatch): `run:` and the handlers it
registers execute in the *caller's* coroutine, not a separate actor's. This is
required — an entity HandlerContext would be enqueued/auto-enrolled when used
inside a transaction, and its `pairs` write would land in a shadow frame while
`_primHCRun:` reads the live slot, losing the handlers. Being a Value, `on:do:`
is functional (returns a new HandlerContext with the pair prepended) since the
instance is frozen after construction."
Value subclass: #HandlerContext
    instanceVariableNames: 'pairs'
    classVariableNames: ''
    indexedSlots: #none.

HandlerContext >> initialize       [ pairs := nil ]
HandlerContext >> pvtSetPairs: c   [ pairs := c ]
HandlerContext >> pairs            [ ^pairs ]

HandlerContext class >> pvtPairs: aCons [
    ^self _primNewValue: [:hc | hc pvtSetPairs: aCons]
]

"Functional: returns a new HandlerContext with (cls -> blk) prepended."
HandlerContext >> on: cls do: blk  [
    ^HandlerContext pvtPairs: (Cons with: (cls -> blk) rest: pairs)
]

"Register all (cls -> blk) associations from anArray in one go, then run body.
Folds with inject:into: (no in-place mutation, since self is frozen)."
HandlerContext >> on: anArray run: body [
    ^(anArray inject: self into: [:hc :assoc | hc on: assoc key do: assoc value]) run: body
]

HandlerContext >> run: body        [ ^self _primHCRun: body ]

"Numeric tower & scalar value classes (docs/numeric_tower_plan.md).
All are encodings of Value instances, reparented under Value so `isKindOf: Value`
holds. Representation runs down the is-a spine: MachineInteger = Value::Int(i64),
ArbitraryInteger = Value::LargeInt(BigInt), Float = Value::Float(f64). Integer is the
abstract shared class (bare `Int` retired); integer literals produce MachineInteger,
promoting to ArbitraryInteger on overflow. String/Symbol are direct Value leaves;
comparability is the `Ordered` trait (§2a), not a class, so String `uses: Ordered`
without being a Number. Reflection is routed via lookup_user_method arms +
value_to_class_handle. S1a: ordinary subclass:; the encoded leaves become vmSubclass:
(closed) in S1b. S2 moved the comparison protocol into Smol (Ordered trait + leaf
`_primLt:`) and S3 the arithmetic (leaf `_primAdd:` … + the `adaptTo…andSend:`
coercion edge); the Rust `dispatch_int`/`dispatch_float` arms these now shadow are
pruned in S5."

"Ordered — the base comparability trait (docs/numeric_tower_plan.md §2a). Comparability
is a *capability*, not a representation, so it lives on the trait axis (§4d), NOT as a
`Magnitude` class on the is-a spine (that class is dissolved here). Requires `<` (and
`=`, universally available on values); provides the rest of the comparison protocol
derived from `<` alone via total-order negation. Members `use:` it — `Number`,
`String`, later `Character` — with no false `is-a Number`/`is-a Magnitude`. A richer
`Magnitude` trait (`uses: Ordered` + metric `-`/zero, for quantities like Duration/
Measurement) is recorded but deferred (§2a)."
Trait named: #Ordered.
Ordered >> <= other            [ ^(other < self) not ]
Ordered >> >  other            [ ^other < self ]
Ordered >> >= other            [ ^(self < other) not ]
Ordered >> max: other          [ ^(self < other) ifTrue: [other] ifFalse: [self] ]
Ordered >> min: other          [ ^(self < other) ifTrue: [self] ifFalse: [other] ]
Ordered >> between: lo and: hi  [ ^(self < lo) not and: [(hi < self) not] ]

Value subclass: #Number
    uses: Ordered
    instanceVariableNames: ''
    classVariableNames: ''
    indexedSlots: #none.

Number subclass: #Integer
    instanceVariableNames: ''
    classVariableNames: ''
    indexedSlots: #none.

"The encoded leaves (fixed native Value representation) are defined with
vmSubclass:, marking them closed — `subclass:` on them is rejected. The abstract
tower classes above (Number/Integer) stay open ordinary subclasses."

Integer vmSubclass: #MachineInteger
    instanceVariableNames: ''
    classVariableNames: ''
    indexedSlots: #none.

Integer vmSubclass: #ArbitraryInteger
    instanceVariableNames: ''
    classVariableNames: ''
    indexedSlots: #none.

Number vmSubclass: #Float
    instanceVariableNames: ''
    classVariableNames: ''
    indexedSlots: #none.

"The value / withValue: seam (plan §4e; scope lifted to Value 2026-08-01).

  value       reduces the receiver to its encoded value. The default `^self` is the
              block-or-value idiom in full generality (a value reduces to itself) and
              lives on Value, so String/Symbol/Bool answer it too — they are not
              `closed`. For the numeric tower it doubles as the projection seam:
              `self value` hands abstract arithmetic an encoded leaf to feed a _prim.
  withValue:  reconstructs the receiver's kind around a computed value; the default
              answers the bare value (identity for a leaf; the escape hatch for a
              wrapper whose op leaves its domain, e.g. `/` may answer a Float).

`Number >> value` OVERRIDES the Value default with `subclassResponsibility`: Number
is *open* to subclassing and the `^self` default is wrong for a boxed wrapper, whose
`self` is not a leaf — so a Number subclass MUST project. That override is the price
of openness; the closed leaves answer `^self` (identity) and String, being a closed
vmSubclass: leaf with no open subclass, safely inherits the Value default. A wrapper
implements `value` (+ `withValue:` when it wants closed arithmetic) and inherits the
tower. Structured numbers (Fraction, Complex) have no single leaf; they override the
arithmetic itself and never reach the seam."

Value  >> value             [ ^self ]
Value  >> withValue: aValue [ ^aValue ]

Number >> value             [ ^self subclassResponsibility ]

MachineInteger   >> value [ ^self ]
ArbitraryInteger >> value [ ^self ]
Float            >> value [ ^self ]

"The tower's `<` (plan §2a, S2). The `_primLt:` grounding lives on the LEAVES, where
`self` IS the raw encoding — a `_prim` may only be sent to `self` (eval.rs self-only
check), so the abstract seam canNOT do `self value _primLt: ...` (that sends _prim to
a projection). Instead:
  - each leaf sends `_primLt:` to self, projecting only the ARG (`aNumber value`), so
    a wrapper argument grounds too;
  - abstract `Number` (for a user wrapper whose self is a boxed object) projects self
    with `value` and RE-DISPATCHES `<` to the resulting leaf.
`_primLt:` compares any two numeric leaf encodings (Int/LargeInt/Float) with
promotion, so cross-type comparison (`2 < 3.5`) is fixed entirely in Rust; Smol
double-dispatch is only for user structured numbers that override `<` (S3). This
project-then-redispatch shape is the general seam→prim pattern (S3 arithmetic does
`self withValue: (self value op: aNumber value)` the same way)."
Number           >> < aNumber [ ^self value < aNumber ]
MachineInteger   >> < aNumber [ ^self _primLt: aNumber value ]
ArbitraryInteger >> < aNumber [ ^self _primLt: aNumber value ]
Float            >> < aNumber [ ^self _primLt: aNumber value ]

"The tower's `=` (plan §4g, S6). Same seam→prim shape as `<`, and grounded by the SAME
promotion policy (`numeric_eq` mirrors `numeric_lt`), so `<`, `=` and `>` agree with one
another. Before S6 there was no `Number >> =` at all: equality fell through to Rust
variant equality for the leaves and to IDENTITY for a wrapper, so `2 = 2.0` was false
while `2 < 2.0` promoted — leaving the `Ordered` trait's requirement that `=` agree with
the order unmet — and `Boxed(0) = 0` was false, which silently broke `isZero`, `even`,
`odd`, and made `gcd:`/`lcm:` recurse past their base case into division by zero.

`=` differs from `<` in TWO respects.

First, it must be TOTAL: `3 < nil` may signal, but `3 = nil` must answer false. So a
leaf must never project an argument it knows nothing about — `aNumber value` MNUs on a
plain Object (no seam) and raises subclassResponsibility on a STRUCTURED number such as
Fraction (a Number with no single encoding to project onto).

Second, `=` is SYMMETRIC, and unlike arithmetic it needs no coercion edge of its own to
exploit that: `=` is already the universal public selector, so a leaf that cannot ground
the comparison simply HANDS THE OPERANDS BACK the other way round. No private
double-dispatch selector, no new protocol:
  - a seam wrapper bounces into `Number >> =`, which projects self and re-dispatches;
  - a structured number answers with its own `=`;
  - a non-number answers with identity `=`, i.e. false.

TERMINATION: `Number >> =` projects self to a leaf BEFORE re-dispatching, so each bounce
strictly reduces the number of non-encoded operands — at most two. (The usual
double-dispatch caveat applies: a user `=` that hands back without projecting can loop.)

`~=` is derived once on Number rather than per leaf; the leaves inherit it. Defining it
is required because the Rust `~=` arms would otherwise still answer raw variant
inequality and contradict the new `=`."
Number           >> =  aNumber [ ^self value = aNumber ]
Number           >> ~= aNumber [ ^(self = aNumber) not ]
MachineInteger   >> =  aNumber [
    ^aNumber isEncodedNumber ifTrue: [ self _primEq: aNumber ] ifFalse: [ aNumber = self ] ]
ArbitraryInteger >> =  aNumber [
    ^aNumber isEncodedNumber ifTrue: [ self _primEq: aNumber ] ifFalse: [ aNumber = self ] ]
Float            >> =  aNumber [
    ^aNumber isEncodedNumber ifTrue: [ self _primEq: aNumber ] ifFalse: [ aNumber = self ] ]

"Arithmetic (plan §4, S3). Same seam→prim shape as `<`: the `_prim` grounding lives
on the LEAVES (where self IS the encoding), abstract Number projects self and
reconstructs. `_primAdd:` and friends promote across all three leaf encodings in
Rust — any Float ⇒ f64, else any LargeInt ⇒ BigInt, else i64 with overflow
promoting and results demoting when they fit a word — so cross-type arithmetic
(`2 + 3.5`, symmetric with `3.5 + 2`) is fixed there, exactly as `2 < 3.5` was.

An operand that is NOT an encoded number (a user Fraction, Complex, or wrapper)
cannot reach the primitive, so the leaf hands the operation to the ARGUMENT via
`adaptToInteger:andSend:` / `adaptToFloat:andSend:` — double dispatch, so a new
number type integrates by implementing two methods ON ITSELF, with no central
generality table to edit and NO change to these closed vmSubclass: leaves. That
extension edge is the committed design; `isEncodedNumber` is merely how the
leaves detect the case internally (private, swappable, invisible to an extender).

`//` and `\\` are integer protocol and are deliberately absent from Float.

Abstract `Number` projects SELF ONLY (`self value + aNumber`, not `aNumber value`):
the inner send re-dispatches on a leaf receiver, so a leaf argument grounds in the
primitive while a second wrapper still reaches double dispatch. Projecting the
argument here would silently receiver-wins-wrap `wrapperA + wrapperB` (plan §4e
case 2). `withValue:` then reconstructs the receiver's kind around the result."

Object           >> isEncodedNumber [ ^false ]
MachineInteger   >> isEncodedNumber [ ^true ]
ArbitraryInteger >> isEncodedNumber [ ^true ]
Float            >> isEncodedNumber [ ^true ]

"Abstract arithmetic — the SPECIFICITY RULE (plan §4g, S5). An encoded leaf carries no
domain; a wrapper carries one. So the wrapper's domain wins regardless of operand
POSITION, which is what makes `3 * boxed` and `boxed * 3` agree. (S3 projected self only
and let the leaf handle the rest; that put the receiver into ARGUMENT position for
`squared`/`factorial`/`gcd:`/`lcm:`, where the leaf could not ground it. Discriminating
on same-class alone does not work either: it answers a leaf for `boxed * 3` but a
wrapper for `3 * boxed`, losing the wrapper exactly where it is the receiver.)

The guard splits two cases:
  - argument is an encoded leaf, OR is the same class as the receiver ⇒ both operands
    project to leaves, so compute on the leaves and reconstruct once. This is the
    original pre-S3 form, and the guard is precisely what makes `withValue:`'s
    `Requires: aValue is an encoded leaf` hold BY CONSTRUCTION.
  - a DIFFERENT wrapper ⇒ neither side may unilaterally claim the result, so hand off to
    domain-named double dispatch with the receiver INTACT (pvtAdapt:send: below).

Comparison and `=` need no such guard: they answer a Bool and never reconstruct."
Number >> pvtCoercible: aNumber [
    ^aNumber isEncodedNumber or: [aNumber class = self class]
]

Number >> + aNumber [
    ^(self pvtCoercible: aNumber)
        ifTrue:  [ self withValue: (self value + aNumber value) ]
        ifFalse: [ self pvtAdapt: aNumber send: #+ ] ]
Number >> - aNumber [
    ^(self pvtCoercible: aNumber)
        ifTrue:  [ self withValue: (self value - aNumber value) ]
        ifFalse: [ self pvtAdapt: aNumber send: #- ] ]
Number >> * aNumber [
    ^(self pvtCoercible: aNumber)
        ifTrue:  [ self withValue: (self value * aNumber value) ]
        ifFalse: [ self pvtAdapt: aNumber send: #* ] ]
Number >> / aNumber [
    ^(self pvtCoercible: aNumber)
        ifTrue:  [ self withValue: (self value / aNumber value) ]
        ifFalse: [ self pvtAdapt: aNumber send: #/ ] ]

Integer >> // aNumber [
    ^(self pvtCoercible: aNumber)
        ifTrue:  [ self withValue: (self value // aNumber value) ]
        ifFalse: [ self pvtAdapt: aNumber send: #// ] ]
Integer >> \\ aNumber [
    ^(self pvtCoercible: aNumber)
        ifTrue:  [ self withValue: (self value \\ aNumber value) ]
        ifFalse: [ self pvtAdapt: aNumber send: #\\ ] ]

"Domain-named double dispatch (plan §4g). The adapt selector names the RECEIVER's
DOMAIN, not its encoding — which is why all three integer leaves present as
#adaptToInteger:andSend:, sharing one domain — and the ARGUMENT implements it. This is
what adaptToInteger:/adaptToFloat: already were; S5 merely extends the idea past the two
leaf domains, so `Number` finally has something to send. A wrapper class Audited is
asked for #adaptToAudited:andSend: and receives the receiver INTACT: projecting the
receiver to a leaf first (as the leaves must, having nothing else to send) would erase
its type and silently reduce to Python __radd__ semantics.

The closed vmSubclass: leaves keep their own hardcoded sends and are NOT touched, so
§4f's decisive criterion — extending the tower never requires editing a leaf — holds.

`respondsTo:` is asked BEFORE sending so NoCoercion can carry both operands
un-projected; the alternative (send blindly, intercept the DNU) would need string
predicates on selectors that do not exist, and would use condition handling for control
flow, which docs/condition_system_guide.md steers away from."
"The pins belong on the LEAVES, not on abstract Integer/Float: the domain claim is
`this encoding presents as the Integer domain`, which is true of the two integer leaves
and false of a user `Integer subclass: #Boxed`. Pinning abstract `Integer` would make
every user subclass inherit the claim and ask for #adaptToInteger:andSend: instead of
its own #adaptToBoxed:andSend: — silently routing to the wrong coercion method."
Number           >> adaptSelector [ ^('adaptTo', self class name, ':andSend:') asSymbol ]
MachineInteger   >> adaptSelector [ ^#adaptToInteger:andSend: ]
ArbitraryInteger >> adaptSelector [ ^#adaptToInteger:andSend: ]
Float            >> adaptSelector [ ^#adaptToFloat:andSend: ]

Number >> pvtAdapt: aNumber send: aSymbol [
    | sel |
    sel := self adaptSelector.
    ^(aNumber respondsTo: sel)
        ifTrue:  [ aNumber perform: sel
                     withArguments: (Cons with: self rest: (Cons with: aSymbol rest: nil)) ]
        ifFalse: [ (NoCoercion receiver: self argument: aNumber selector: aSymbol) signal ] ]

MachineInteger >> + aNumber [
    ^aNumber isEncodedNumber
        ifTrue:  [ self _primAdd: aNumber ]
        ifFalse: [ aNumber adaptToInteger: self andSend: #+ ] ]
MachineInteger >> - aNumber [
    ^aNumber isEncodedNumber
        ifTrue:  [ self _primSub: aNumber ]
        ifFalse: [ aNumber adaptToInteger: self andSend: #- ] ]
MachineInteger >> * aNumber [
    ^aNumber isEncodedNumber
        ifTrue:  [ self _primMul: aNumber ]
        ifFalse: [ aNumber adaptToInteger: self andSend: #* ] ]
MachineInteger >> / aNumber [
    ^aNumber isEncodedNumber
        ifTrue:  [ self _primDiv: aNumber ]
        ifFalse: [ aNumber adaptToInteger: self andSend: #/ ] ]
MachineInteger >> // aNumber [
    ^aNumber isEncodedNumber
        ifTrue:  [ self _primQuo: aNumber ]
        ifFalse: [ aNumber adaptToInteger: self andSend: #// ] ]
MachineInteger >> \\ aNumber [
    ^aNumber isEncodedNumber
        ifTrue:  [ self _primRem: aNumber ]
        ifFalse: [ aNumber adaptToInteger: self andSend: #\\ ] ]

ArbitraryInteger >> + aNumber [
    ^aNumber isEncodedNumber
        ifTrue:  [ self _primAdd: aNumber ]
        ifFalse: [ aNumber adaptToInteger: self andSend: #+ ] ]
ArbitraryInteger >> - aNumber [
    ^aNumber isEncodedNumber
        ifTrue:  [ self _primSub: aNumber ]
        ifFalse: [ aNumber adaptToInteger: self andSend: #- ] ]
ArbitraryInteger >> * aNumber [
    ^aNumber isEncodedNumber
        ifTrue:  [ self _primMul: aNumber ]
        ifFalse: [ aNumber adaptToInteger: self andSend: #* ] ]
ArbitraryInteger >> / aNumber [
    ^aNumber isEncodedNumber
        ifTrue:  [ self _primDiv: aNumber ]
        ifFalse: [ aNumber adaptToInteger: self andSend: #/ ] ]
ArbitraryInteger >> // aNumber [
    ^aNumber isEncodedNumber
        ifTrue:  [ self _primQuo: aNumber ]
        ifFalse: [ aNumber adaptToInteger: self andSend: #// ] ]
ArbitraryInteger >> \\ aNumber [
    ^aNumber isEncodedNumber
        ifTrue:  [ self _primRem: aNumber ]
        ifFalse: [ aNumber adaptToInteger: self andSend: #\\ ] ]

Float >> + aNumber [
    ^aNumber isEncodedNumber
        ifTrue:  [ self _primAdd: aNumber ]
        ifFalse: [ aNumber adaptToFloat: self andSend: #+ ] ]
Float >> - aNumber [
    ^aNumber isEncodedNumber
        ifTrue:  [ self _primSub: aNumber ]
        ifFalse: [ aNumber adaptToFloat: self andSend: #- ] ]
Float >> * aNumber [
    ^aNumber isEncodedNumber
        ifTrue:  [ self _primMul: aNumber ]
        ifFalse: [ aNumber adaptToFloat: self andSend: #* ] ]
Float >> / aNumber [
    ^aNumber isEncodedNumber
        ifTrue:  [ self _primDiv: aNumber ]
        ifFalse: [ aNumber adaptToFloat: self andSend: #/ ] ]

"The coercion edge. A number type that is not an encoded leaf implements these two
methods to join the tower: it receives the original RECEIVER plus the operator
symbol, promotes the receiver into its own domain, and performs the operation.

The refusing defaults sit on Object, not Number, so that `3 + 'bad'` reports a clear
coercion error rather than a MessageNotUnderstood naming an internal selector — the
same reason `isEncodedNumber` defaults at the root.

PROVISIONAL PLACEMENT: these three fallbacks belong on a `NumberCoercion` TRAIT
(capability axis, §4d) rather than accreting numeric vocabulary on Object. That needs
a standalone `SomeClass uses: SomeTrait.` statement — `uses:` is currently a clause of
subclass:/vmSubclass: only, and Object is bootstrapped in Rust — which is a
trait-system step with its own design questions. See plan §4f, `NumberCoercion` trait.

`Float >> adaptToInteger:andSend:` is the worked example. It is not reachable from
integer arithmetic (the primitive already promotes Int→Float), but it documents the
shape and keeps Float a well-behaved participant if an integer-like user class ever
delegates to it."

Object >> adaptToInteger: anInteger andSend: aSymbol [
    ^(NoCoercion receiver: anInteger argument: self selector: aSymbol) signal ]
Object >> adaptToFloat: aFloat andSend: aSymbol [
    ^(NoCoercion receiver: aFloat argument: self selector: aSymbol) signal ]

Float >> adaptToInteger: anInteger andSend: aSymbol [
    ^anInteger asFloat perform: aSymbol withArguments: (Cons with: self rest: nil) ]

"Default coercion for a SEAM-HAVING wrapper (plan §4g, S5). Reached only when a LEAF is
the receiver and the wrapper is the argument (`3 * boxed`) — the specificity guard above
handles every case where the wrapper is the receiver, and never calls these. Project
self to a leaf, let the leaf perform the operation with the ORIGINAL OPERAND ORDER
preserved (anInteger stays on the left, since the send was `anInteger op self`), then
reconstruct in the wrapper's own domain.

This is what makes §4c's `a wrapper implements TWO methods and inherits the tower` true
rather than aspirational: with these defaults, `value` + `withValue:` is genuinely
sufficient for full participation in BOTH operand positions.

Note this was UNSAFE before S5 and is safe now: under S3's unconditional
`self withValue: (…)` the reconstructed wrapper returned here was wrapped a SECOND time
by the calling abstract op. The specificity guard removes that call path entirely — when
the argument is an encoded leaf the guard takes the project-both branch and never
reaches coercion — so the §4e contract `withValue: Requires an encoded leaf` holds.

Structured numbers (Fraction, Complex) have no single leaf to project onto; they
override these to do real domain arithmetic and never reach the seam."
Number >> adaptToInteger: anInteger andSend: aSymbol [
    ^self withValue: (anInteger perform: aSymbol withArguments: (Cons singleton: self value)) ]
Number >> adaptToFloat: aFloat andSend: aSymbol [
    ^self withValue: (aFloat perform: aSymbol withArguments: (Cons singleton: self value)) ]

Value vmSubclass: #String
    uses: Ordered
    instanceVariableNames: ''
    classVariableNames: ''
    indexedSlots: #none.

"Lexicographic order (plan §2a). String is Ordered but NOT a Number/Magnitude —
`'cat' - 'cab'` is meaningless. Grounds to the `_primStrLt:` primitive."
String >> < aString [ ^self _primStrLt: aString ]

"The String protocol (C34 S4). Every one of these was a Rust `match` arm; what
remains in `dispatch_str` is only the `_prim` grounding they send to, which is
irreducible — indexing into UTF-8, concatenating, and interning a Symbol all need
host support. The payoff is that String now answers `respondsTo:` accurately, can
be read and extended from Smol, and that new operations (`split`, `trimmed`,
`startsWith:`, `asUppercase`, …) are ordinary Smol methods rather than new Rust.

INDEXING IS 0-BASED, which changes `at:`. It was 1-based (`chars().nth(i - 1)`,
the Smalltalk-80 convention) while every collection was 0-based — the same
inconsistency S3a settled for `copyFrom:to:`. Leaving it would have made String
incoherent with ITSELF after S3a: `'hello' copyFrom: 0 to: 0` answered `'h'` while
`'hello' at: 0` was out of bounds and `at: 1` answered `'h'`. Same class, two bases.
`docs/string_representation_plan.md` §3 specified 1-based; this chunk supersedes it.

`copyFrom:until:` is the primitive and `copyFrom:to:` derives (S3a), matching the
collections — the half-open form needs no adjustment arithmetic.

`at:` answers a one-character String; it becomes a `Character` when that class
lands (old plan §6, still wanted)."
String >> size                   [ ^self _primSize ]
String >> at: index              [ ^self _primAt: index ]
String >> , aString              [ ^self _primConcat: aString ]
String >> reversed               [ ^self _primReversed ]
String >> asSymbol               [ ^self _primAsSymbol ]
String >> includesSubString: sub [ ^self _primIncludesSubString: sub ]

String >> copyFrom: start until: stop [ ^self _primCopyFrom: start until: stop ]
String >> copyFrom: start to: stop    [ ^self copyFrom: start until: stop + 1 ]

"`isEmpty` answered FALSE for `''` before S4, because String had no method
dictionary to define it in and the send fell through to `Object >> isEmpty [^false]`.
That is a wrong answer rather than a missing feature, and having a real String class
is exactly what makes it fixable — Array and OrderedCollection both define it."
String >> isEmpty  [ ^self size = 0 ]
String >> notEmpty [ ^self isEmpty not ]

"Programmatic construction WITHOUT mutability (C34 S4). Immutability forbids
mutating a value after it exists; it does not forbid CONSTRUCTING one. The
repetition happens in a host buffer and the resulting String is born complete and
frozen, which is categorically different from the allocate-then-poke construction
the retired plan's §5 rejects. That distinction is exactly why `String new: 20` is
refused while `String new: 20 withAll: 'X'` is not: you cannot get n empty slots to
fill in later, but you can get n filled ones.

The primitive is INSTANCE-side because a `_prim` may only be sent to `self`, and
class-side `self` is the class, not the fill value — so `new:withAll:` cannot ground
directly and delegates instead. That constraint pushed out the better factoring:
`repeated:` also handles multi-character strings, which `new:withAll:` alone would
not (`'ab' repeated: 3`). `repeated:` (not `repeat:`) follows the answers-a-copy
convention `reversed` already sets.

`withAll:` takes a ONE-CHARACTER STRING until `Character` exists (retired plan §6),
which is consistent with `at:` already answering one-character Strings. Both change
together when that class lands. Note it accepts any String, so it is really
`new:withAll:`'s more general sibling — nothing breaks if the fill is longer, you
simply get `n` copies of it.

Open-ended accumulation — building a string in a loop, or conditionally — still
wants a mutable `StringBuilder`/`WriteStream` (§5, still open). Factories cover
fixed-shape construction; they do not replace the builder."
String >> repeated: n [ ^self _primRepeated: n ]

"A String's bare rendering is itself — no primitive needed. The debug rendering
quotes it, which is what lets a collection show that an element IS a string.
A quote is doubled to escape it (per the lexer), so the four-quote literal below
is a String containing exactly one quote character."
String >> asString      [ ^self ]
String >> asDebugString [ ^'''' , self , '''' ]

"Grounds the console channel; `Object >> print` converts and delegates here."
String >> print   [ self _primWrite.     ^self ]
String >> printNl [ self _primWriteLine. ^self ]

String class >> new: n withAll: aChar [ ^aChar repeated: n ]

Value vmSubclass: #Symbol
    instanceVariableNames: ''
    classVariableNames: ''
    indexedSlots: #none.

"Symbol conversions (C34 S2). `asSymbol` needs no primitive at all — a Symbol
already IS one, so the conversion is the identity and says so in Smol rather
than in a Rust arm that rebuilt the same value. `asString` hands back the
symbol's characters and does need host support; `_primAsString` renders an
encoded value and branches on the encoding internally, so S3 extends it to the
numeric leaves rather than adding a selector per family.

`=`, `~=`, `==` and `~~` are NOT defined here: Symbol inherits them from Object
(§6 OQ-3), where `==` is structural for an encoded scalar — two occurrences of
`#foo` are the same value, not two allocations."
Symbol >> asString      [ ^self _primAsString ]
Symbol >> asSymbol      [ ^self ]
Symbol >> asDebugString [ ^'#' , self asString ]

"Boolean hierarchy — True and False are singleton-style classes.
Value::Bool(b) is the runtime representation; Bool is routed through
lookup_user_method so these methods are found at step (1) of dispatch_to_stack."

Value subclass: #Boolean
    instanceVariableNames: ''
    classVariableNames: ''
    indexedSlots: #none.

Boolean vmSubclass: #True
    instanceVariableNames: ''
    classVariableNames: ''
    indexedSlots: #none.

Boolean vmSubclass: #False
    instanceVariableNames: ''
    classVariableNames: ''
    indexedSlots: #none.

True  >> ifTrue: aBlock             [ ^aBlock value ]
True  >> ifFalse: aBlock            [ ^nil ]
True  >> ifTrue: t ifFalse: f       [ ^t value ]
True  >> ifFalse: f ifTrue: t       [ ^t value ]
True  >> and: aBlock                [ ^aBlock value ]
True  >> or: aBlock                 [ ^true ]
True  >> not                        [ ^false ]
True  >> xor: aBool                 [ ^aBool not ]
True  >> asString                   [ ^'true' ]
True  >> = other                    [ ^other isKindOf: True ]
True  >> & other                    [ ^other ]
True  >> | other                    [ ^true ]

False >> ifTrue: aBlock             [ ^nil ]
False >> ifFalse: aBlock            [ ^aBlock value ]
False >> ifTrue: t ifFalse: f       [ ^f value ]
False >> ifFalse: f ifTrue: t       [ ^f value ]
False >> and: aBlock                [ ^false ]
False >> or: aBlock                 [ ^aBlock value ]
False >> not                        [ ^true ]
False >> xor: aBool                 [ ^aBool not ]
False >> asString                   [ ^'false' ]
False >> = other                    [ ^other isKindOf: False ]
False >> & other                    [ ^false ]
False >> | other                    [ ^other ]

Boolean >> ~= other                 [ ^(self = other) not ]

"── Construction of the encoded leaves ───────────────────────────────────────

Absorbed from `docs/string_representation_plan.md` §4 (retired; C34 S4). Its point
was a real defect, not a nicety: an encoded leaf must NEVER reach generic
construction. `Value class >> new` builds a frozen `ValueObject` via
`_primNewValue:`, so before this every one of the seven leaves answered a
ValueObject that CLAIMED to be a String/Integer/Float but was not the encoding —
`String new` answered `a String` whose `size` failed with 'receiver has no indexed
storage' and for which `String new = ''` was false. Same for `Symbol new`,
`Float new`, `True new`, and the rest.

THE RULE: a leaf answers its identity value when one exists that is honestly an
instance of that class, and refuses otherwise. The test is `(X new) class = X`.
`''`, `0`, `0.0`, `true`, `false` each satisfy it, and none needs a primitive —
a literal already IS the encoding.

The two refusals are refusals because the constraint FAILS, not for lack of
imagination. `ArbitraryInteger new` would have to answer `0`, but `0 class` is
MachineInteger — the leaves are two encodings of one domain and the small one
wins for small values, so there is no ArbitraryInteger zero to hand back. A
Symbol has no identity element at all: symbols are interned names, reached by
`asSymbol`, and an 'empty symbol' names nothing.

`new:` is refused for every leaf. Indexed construction means `n` slots to fill,
which presumes mutability — and §5 of the retired plan rejects mutable strings
outright: incremental building belongs in a separate mutable Object (a
StringBuilder / WriteStream), which is still open design work. The old error for
`String new: 3` came from deep inside the generic path ('requires class to declare
indexedSlots:') and said nothing about any of this."

String           class >> new [ ^'' ]
MachineInteger   class >> new [ ^0 ]
Float            class >> new [ ^0.0 ]
True             class >> new [ ^true ]
False            class >> new [ ^false ]

Symbol class >> new [
    ^Error signal: 'Symbol new: symbols are interned names — use #foo or aString asSymbol' ]
ArbitraryInteger class >> new [
    ^Error signal: 'ArbitraryInteger new: no zero of this class exists (0 is a MachineInteger)' ]

String           class >> new: n [ ^self pvtRefuseIndexed ]
Symbol           class >> new: n [ ^self pvtRefuseIndexed ]
MachineInteger   class >> new: n [ ^self pvtRefuseIndexed ]
ArbitraryInteger class >> new: n [ ^self pvtRefuseIndexed ]
Float            class >> new: n [ ^self pvtRefuseIndexed ]
True             class >> new: n [ ^self pvtRefuseIndexed ]
False            class >> new: n [ ^self pvtRefuseIndexed ]

Object class >> pvtRefuseIndexed [
    ^Error signal: self name , ' new: an encoded scalar has no indexed slots' ]

"Loop — pure Smol recursive implementations enabled by inline block dispatch and
TCO in the iterative evaluator. There is no Rust fallback: the `_primWhileTrue:` /
`_primTimesRepeat:` arms these methods once shadowed were removed with the recursive
evaluator (retired 2026-07), so these bodies ARE the implementation. (C34 OQ-1c: the
note that used to sit here described those arms as live.)

The body is run via `aBlock value`, which is deliberately NOT type-checked (C29.6).
Since `Value >> value [^self]` (§4e), a non-block body is legal and simply evaluates
to itself each pass — e.g. `[cond] whileTrue: 42` uses 42 as the body result (a
harmless no-op that never mutates state) rather than raising. This is the
block-or-value idiom applied uniformly, not an error path."

Block >> whileTrue: aBlock [
    self value ifFalse: [ ^nil ].
    aBlock value.
    ^self whileTrue: aBlock
]

Block >> whileFalse: aBlock [
    self value ifTrue: [ ^nil ].
    aBlock value.
    ^self whileFalse: aBlock
]

Block >> whileTrue [
    self value ifFalse: [ ^nil ].
    ^self whileTrue
]

Block >> whileFalse [
    self value ifTrue: [ ^nil ].
    ^self whileFalse
]

"Numeric conversions (plan chunk_34 §5, S3). Pure `_prim` grounding — no protocol
design, which is why these sit on the LEAVES rather than on abstract Number/Integer.
A `_prim` may only be sent to `self` (self-only rule) and only a leaf IS the encoding,
so grounding lives here; the abstract projecting form (`Number >> asFloat
[^self value asFloat]`, the §4e seam) would be a genuine protocol ADDITION — a wrapper
answers doesNotUnderstand to `asFloat` today, exactly as it did before this step — and
is left for a later step rather than smuggled in here. Same for `Integer >> rounded`
and friends (identity on an integer) and `Float >> asFloat`.

`asInt` needs no primitive: it IS truncation, and now says so in Smol instead of
being a fifth Rust arm that happened to do the same `as i64` cast."
MachineInteger   >> asFloat  [ ^self _primAsFloat ]
ArbitraryInteger >> asFloat  [ ^self _primAsFloat ]
MachineInteger   >> asString [ ^self _primAsString ]
ArbitraryInteger >> asString [ ^self _primAsString ]

Float >> truncated [ ^self _primTruncated ]
Float >> rounded   [ ^self _primRounded ]
Float >> ceiling   [ ^self _primCeiling ]
Float >> floor     [ ^self _primFloor ]
Float >> asInt     [ ^self truncated ]

"── Number and Integer protocol (plan §4c, S4) ───────────────────────────────

Authored in Smol on the ABSTRACT classes, which is the payoff of the tower: this is
real numeric behavior a user can read, edit, and extend, not hardcoded Rust. Every
method here is ENCODING-AGNOSTIC (§4c) — pure protocol self-sends, never a `_prim`,
never a named Value variant, never an assumption that `self` IS a leaf. So they work
unchanged for a user `ModularInteger` or a `Boxed` wrapper, whose `self` is a boxed
ValueObject: each self-send re-dispatches, reaching the leaves (or the wrapper's own
overrides) at the bottom.

Two shapes recur. `negated` is written `self * -1` rather than `0 - self` because the
receiver must stay on the LEFT: with the receiver on the left a wrapper enters via
`Number >> *`, which projects and reconstructs through the seam; with the receiver on
the right it would instead have to satisfy the coercion edge. `abs`/`sign` answer via
comparison, so they inherit cross-type correctness from `<` for free.

Recursion rather than loop accumulation throughout: a method temporary cannot be
assigned from inside a block (Smol_Patterns pattern 1), and the ValueHolder
accumulator pattern would drag an entity into pure value arithmetic. `gcd:` and
`pvtHasNoOddFactorFrom:` are tail-recursive (TCO makes them O(1) stack); `factorial`
is not, but the iterative evaluator holds its frames on the heap Cont stack, so depth
costs heap rather than Rust stack."

Number >> negated    [ ^self * -1 ]
Number >> abs        [ ^self < 0 ifTrue: [ self negated ] ifFalse: [ self ] ]
Number >> squared    [ ^self * self ]
Number >> reciprocal [ ^1 / self ]
Number >> isZero     [ ^self = 0 ]

"sign answers a plain Integer (-1/0/1), not the receiver's kind: it is a
classification of the receiver, not a quantity in the receiver's domain, so it must
NOT go through withValue:."
Number >> sign [
    self < 0 ifTrue: [ ^-1 ].
    self > 0 ifTrue: [ ^1 ].
    ^0
]

Integer >> even [ ^(self \\ 2) = 0 ]
Integer >> odd  [ ^self even not ]

"Euclid's algorithm, tail-recursive. `abs` on the base case keeps the result
non-negative for negative operands, per the usual convention gcd(-12, 8) = 4."
Integer >> gcd: anInteger [
    anInteger isZero ifTrue: [ ^self abs ].
    ^anInteger gcd: self \\ anInteger
]

"lcm via gcd. Guards zero first: lcm(0, n) = 0 and the gcd would be zero, so the
division is undefined."
Integer >> lcm: anInteger [
    (self isZero or: [ anInteger isZero ]) ifTrue: [ ^0 ].
    ^((self // (self gcd: anInteger)) * anInteger) abs
]

"Overflow is not a special case here: the leaf primitives promote to
ArbitraryInteger as the product grows, so 30 factorial is exact."
Integer >> factorial [
    self < 0 ifTrue: [ ^self error: 'factorial of a negative integer' ].
    self <= 1 ifTrue: [ ^1 ].
    ^self * (self - 1) factorial
]

"Trial division by odd candidates, stopping at sqrt(self) via `k * k > self` — the
tower has no float sqrt, and squaring the candidate avoids needing one. The helper is
tail-recursive so the whole search is O(1) in stack."
Integer >> isPrime [
    self < 2 ifTrue: [ ^false ].
    self even ifTrue: [ ^self = 2 ].
    ^self pvtHasNoOddFactorFrom: 3
]

Integer >> pvtHasNoOddFactorFrom: k [
    k * k > self ifTrue: [ ^true ].
    (self \\ k) isZero ifTrue: [ ^false ].
    ^self pvtHasNoOddFactorFrom: k + 2
]

"Numeric iteration (plan chunk_34 §6 OQ-1, S1b). Before S1b these were not methods at
all: `dispatch_to_stack` step (1c) matched the SELECTOR against a `Value::Int` receiver
and pushed a `Cont::ToDoStep` continuation. That made `to:do:` a syntactic form wearing
a message send's clothing — invisible to `respondsTo:`, impossible to override or
inspect, and silently available only for MachineInteger, so `1.5 to: 3 do: [...]` and
`aLargeInt to: 3 do: [...]` answered doesNotUnderstand on the tower's most-used
iteration construct. Defining them on Number fixes that gap for every leaf at once.

The shape is `Block >> whileTrue:`'s, and for the same reason: an early `^` inside a
guard block, then the recursive send in method STATEMENT position, which is the form
the evaluator's TCO recognises. The classic counter form
(`i := self. [i <= stop] whileTrue: [... i := i + 1]`) is unavailable — a method temp
cannot be assigned from inside a block (Smol_Patterns pattern 1) — so recursion is the
idiom here exactly as it is for `gcd:` and `factorial`.

Bounds are compared with ordinary sends (`<=`, `>=`), which force a Future argument
like any other send, so a future in the receiver, limit or step position resolves
instead of raising. Step (1c) called Rust `as_int` on the bound and rejected a Future
outright, contradicting the asynchronous-everywhere rule (OQ-1b).

`to:by:do:` splits into a public method that validates the step ONCE and a recursive
worker, rather than re-testing `step isZero` every iteration. A zero step must be
rejected explicitly: `step > 0` would be false and `self >= stop` would decide, so
`1 to: 5 by: 0 do: [...]` would answer nil immediately — silently wrong rather than
loudly wrong."

Number >> to: stop do: aBlock [
    (self <= stop) ifFalse: [ ^nil ].
    aBlock value: self.
    ^(self + 1) to: stop do: aBlock
]

"`Error signal:` rather than `self error:` deliberately. `error:` sent to a PRIMITIVE
receiver is uncatchable: dispatch step (1d) gates flattened signal dispatch on an
Instance receiver, so a Number leaf falls through to `dispatch_primitive_fallback`,
which returns a bare `EvalError::Signal` that bypasses the handler chain — `[3 error:
'x'] on: Error do: [...]` does not catch, while `[Error signal: 'x'] on: Error do:
[...]` does. That asymmetry is a pre-existing defect in `error:` (a Rust fallback arm,
see §3's `fallback` row); until it is resolved, kernel code whose `self` may be an
encoded leaf must signal the condition directly."
Number >> to: stop by: step do: aBlock [
    step isZero ifTrue: [ ^Error signal: 'to:by:do: step must be non-zero' ].
    ^step > 0
        ifTrue:  [ self pvtUpTo:   stop by: step do: aBlock ]
        ifFalse: [ self pvtDownTo: stop by: step do: aBlock ]
]

"Two workers rather than one testing `step > 0` per iteration. The step's sign is
loop-INVARIANT, so deciding it once at entry hoists two sends and a block evaluation
out of every iteration — measured at 2.33 s → 1.42 s for 100k iterations, which brings
`to:by:do:` level with `to:do:` instead of half again as slow. It also
leaves each worker in exactly the `to:do:` shape, which is the point: the termination
guard is a single comparison, not a conditional over one."
Number >> pvtUpTo: stop by: step do: aBlock [
    (self <= stop) ifFalse: [ ^nil ].
    aBlock value: self.
    ^(self + step) pvtUpTo: stop by: step do: aBlock
]

Number >> pvtDownTo: stop by: step do: aBlock [
    (self >= stop) ifFalse: [ ^nil ].
    aBlock value: self.
    ^(self + step) pvtDownTo: stop by: step do: aBlock
]

"The EXCLUSIVE dual (C34 S3a). `to:` and `until:` name the two readings of a range
rather than making one convention something you have to remember — the trick Ruby
(`a..b` / `a...b`) and Swift (`a...b` / `a..<b`) use, expressed as keyword selectors
instead of syntax. `to:` includes its bound, `until:` stops before it:

    0 to: 10 do: [...]      11 iterations, 0 through 10
    0 until: 10 do: [...]   10 iterations, 0 through 9

`until:` is what makes Dijkstra's argument (EWD831) available where it pays: the trip
count is `stop - start` with no `+ 1`, an empty range is `start = stop` rather than
`stop < start`, and adjacent ranges share a bound (`0 until: n`, `n until: m`). `to:`
stays the default because it reads the way the word does, and because every existing
loop and `copyFrom:to:` already means it.

The only difference from `to:do:` is `<` in place of `<=` (and `>` for `>=` when the
step is negative), so the shape, the TCO-recognised tail call, and the once-at-entry
step validation are all identical — see the `to:do:` commentary above."

Number >> until: stop do: aBlock [
    (self < stop) ifFalse: [ ^nil ].
    aBlock value: self.
    ^(self + 1) until: stop do: aBlock
]

Number >> until: stop by: step do: aBlock [
    step isZero ifTrue: [ ^Error signal: 'until:by:do: step must be non-zero' ].
    ^step > 0
        ifTrue:  [ self pvtUpUntil:   stop by: step do: aBlock ]
        ifFalse: [ self pvtDownUntil: stop by: step do: aBlock ]
]

Number >> pvtUpUntil: stop by: step do: aBlock [
    (self < stop) ifFalse: [ ^nil ].
    aBlock value: self.
    ^(self + step) pvtUpUntil: stop by: step do: aBlock
]

Number >> pvtDownUntil: stop by: step do: aBlock [
    (self > stop) ifFalse: [ ^nil ].
    aBlock value: self.
    ^(self + step) pvtDownUntil: stop by: step do: aBlock
]

"timesRepeat: recurses on (self - 1) instead of mutating a counter variable,
avoiding NonLocalBlockAssignment. TCO makes this O(1) in Rust stack, and since C34
S1a the env no longer grows per call either, so it is O(1) in memory and linear in
time. (C34 OQ-1c: this note used to claim `_primTimesRepeat:` in dispatch_int as a
live fallback for the recursive evaluator; both were retired in 2026-07.)"
Integer >> timesRepeat: aBlock [
    self > 0 ifFalse: [ ^nil ].
    aBlock value.
    ^(self - 1) timesRepeat: aBlock
]

"── Duration ─────────────────────────────────────────────────────────────────"
"Immutable millisecond-granularity time span.  No arithmetic or comparison."
Value subclass: #Duration
    instanceVariableNames: 'ms'
    classVariableNames: ''
    indexedSlots: #none.

Duration class >> ms: n      [ ^self _primNewValue: [:d | d pvtMs: n] ]
Duration class >> s: n       [ ^self _primNewValue: [:d | d pvtMs: n * 1000] ]
Duration class >> minutes: n [ ^self _primNewValue: [:d | d pvtMs: n * 60000] ]
Duration >> pvtMs: n         [ ms := n ]
Duration >> asMilliseconds   [ ^ms ]
Duration >> asString         [ ^ms asString, 'ms' ]

"── Timer ────────────────────────────────────────────────────────────────────"
"Cancellable one-shot timer.  Value object; immutable after construction."
Value subclass: #Timer
    instanceVariableNames: 'handle block'
    classVariableNames: ''
    indexedSlots: #none.

Timer class >> after: duration do: userBlock [
    | ms |
    ms := duration asMilliseconds.
    ^self _primNewValue: [:t |
        t pvtBlock: userBlock.
        t pvtHandle: (self _primScheduleTimer: ms block: [t pvtTimerFired])
    ]
]

Timer >> pvtBlock: b   [ block := b ]
Timer >> pvtHandle: h  [ handle := h ]
Timer >> pvtTimerFired [ ^block value ]
Timer >> cancel        [ self _primCancelTimer: handle ]
Timer >> isPending     [ ^self _primTimerPending: handle ]

"── TCP sockets (C-web spike) ─────────────────────────────────────────────────"
"Passive value wrappers over opaque OS socket handles (same shape as Timer). The
 `accept`/`read`/`write:` prims run their parking I/O on a fresh coroutine and
 answer a Future, so the async-everywhere model holds — chain with `then:orElse:`."

Value subclass: #TcpSocket
    instanceVariableNames: 'handle'
    classVariableNames: ''
    indexedSlots: #none.

TcpSocket class >> pvtWrapping: h [ ^self _primNewValue: [:s | s pvtHandle: h] ]
TcpSocket >> pvtHandle: h    [ handle := h ]
TcpSocket >> read            [ ^self _primTcpRead: handle ]          "Future of Str; '' = EOF"
TcpSocket >> write: aString  [ ^self _primTcpWrite: handle with: aString ]  "Future of Int"
TcpSocket >> close           [ ^self _primTcpClose: handle ]

Value subclass: #TcpListener
    instanceVariableNames: 'handle'
    classVariableNames: ''
    indexedSlots: #none.

TcpListener class >> onPort: port [
    ^self _primNewValue: [:l | l pvtHandle: (self _primTcpListen: port)]
]
TcpListener >> pvtHandle: h [ handle := h ]
"Answer a Future of the next inbound TcpSocket; rejection propagates down-chain.
 the resolved handle is passed to the `then:` block (1-arg)."
TcpListener >> accept [
    ^(self _primTcpAccept: handle) then: [:h | TcpSocket pvtWrapping: h] orElse: #reject
]

"── World ────────────────────────────────────────────────────────────────────"
"Environment-level queries over the live entity registry."
Object subclass: #World
    instanceVariableNames: ''
    classVariableNames: ''
    indexedSlots: #none.

World class >> instancesOf: aClass [
    ^self _primInstancesOf: aClass
]

"════════════════════════════════════════════════════════════════════════════
 Multi-entity atomic transactions (C31)

 `Transaction atomic: aBlock` runs aBlock as a single atomic unit, passing the
 transaction as the block argument. Tagged work messages the block sends to other
 entities cause those entities to auto-enroll (lock their mailbox + shadow their
 writes). On success the coordinator tells every participant to apply its writes,
 then commits the shared store transaction; on error (or `tx abort`) it tells them
 to discard and rolls back.

 `atomic:` returns immediately with a `TxResult` (the Transaction + a pending
 result future). The block runs under a HandlerContext: when the block's work
 future resolves, a `then:` continuation signals `OkToCommit`, whose handler runs
 the commit and resolves the result; any `Error` (including `tx abort`) is caught
 by the same HandlerContext, which rolls back and rejects the result. Because the
 continuation carries the coordinator's entity id, `self pvtCommit`/`pvtRollback`
 are sync self-sends — they do not enqueue tagged messages back to the coordinator
 (which would wrongly enroll it in its own transaction).

 Contract: the block must sequence (chain/await) the participant work it wants
 included, so the future it yields resolves only after all participants have
 enrolled. Async-participant error propagation (vs. synchronous block errors) is
 not yet covered — see OQ-C31-1 / docs.
 ════════════════════════════════════════════════════════════════════════════"

"Explicit Future: reifies an implicit future so code can create one, hand it
around, and resolve/reject it later. The wrapping is an implementation detail —
clients use `await` (blocks until resolved, like any implicit future) and
`resolveWith:`/`rejectWith:`; the internal handle is never exposed. A Future is a
Value and so is freely shareable across entities/threads; resolution is
single-winner — the first `resolveWith:`/`rejectWith:` wins and any later attempt
signals an error."
Value subclass: #Future
    instanceVariableNames: 'handle'
    classVariableNames: ''
    indexedSlots: #none.

Future class >> new [ ^self _primNewValue: [:f | f pvtInit] ]
Future >> pvtInit          [ handle := self _primNewFutureHandle ]
Future >> await            [ ^handle await ]
"Total async chaining: run `tb` on resolution, `eb` on rejection. `eb` is a 1-arg
block OR a symbol idiom — #signal (re-raise into the current handler chain),
#reject (propagate the rejection down the chain), #value (resolve with the
condition as a plain value). Bare `then:` was removed: the rejection arm must be
stated so it cannot be silently dropped."
Future >> then: tb orElse: eb [ ^handle then: tb orElse: eb ]
Future >> resolveWith: v   [ ^self pvtSettle: (self _primResolveFuture: handle value: v) ]
Future >> rejectWith: e    [ ^self pvtSettle: (self _primRejectFuture: handle error: e) ]

"Seamless forwarding: any message an explicit Future does not itself understand
implicitly awaits resolution and is re-sent to the resolved value — so an
explicit Future behaves like an implicit one (which the evaluator force-resolves
at every use point). await/then:orElse:/resolveWith:/rejectWith: act on the wrapper
and are handled above; everything else forwards here."
Future >> doesNotUnderstand: aMessage [ ^aMessage sendTo: handle await ]

"Single-winner guard: if the prim reports the future was already settled, signal a
typed, restartable condition. Handlers may `invokeRestart: #ignore` to keep the
existing resolution (the late attempt becomes a no-op returning nil)."
Future >> pvtSettle: won [
    won ifTrue: [ ^self ].
    ^((FutureAlreadyResolved withMessage: 'future already resolved')
        addRestart: #ignore block: [:c | nil ]) signal
]

"Internal condition: signaled by the commit continuation once the block's work
has resolved, carrying the block's result. Caught by the transaction's
HandlerContext to run the commit. Not an Error, so the Error handler ignores it."
Condition subclass: #OkToCommit
    instanceVariableNames: 'value'
    classVariableNames: ''
    indexedSlots: #none.

OkToCommit class >> value: v [ ^self _primNewValue: [:c | c pvtSetValue: v] ]
OkToCommit >> pvtSetValue: v [ value := v ]
OkToCommit >> value          [ ^value ]

"Returned by `Transaction atomic:`. `result` is a future that resolves with the
block's value on commit, or rejects on rollback."
Value subclass: #TxResult
    instanceVariableNames: 'transaction result'
    classVariableNames: ''
    indexedSlots: #none.

TxResult class >> transaction: t result: r [
    ^self _primNewValue: [:x | x pvtSetTransaction: t result: r]
]
TxResult >> pvtSetTransaction: t result: r [ transaction := t. result := r ]
TxResult >> transaction [ ^transaction ]
TxResult >> result      [ ^result ]
TxResult >> status      [ ^transaction status ]

"Participant-side trampoline: the coordinator sends pvtExitTx: to finalize each
participant's current transaction frame (#commit applies shadow writes to live
slots and hands the durable buffer up; #rollback discards both)."
Object >> pvtExitTx: outcome [ ^self _primExitTxMode: outcome ]

Object subclass: #Transaction
    instanceVariableNames: 'handle status'
    classVariableNames: ''
    indexedSlots: #none.

"Deadlock-detection timeout (ms): how long an entity may stay blocked on a lock
before the interpreter runs wait-for cycle detection (C31 S5c). Stored in the VM
(see _primSetDeadlockTimeoutMs:); default 500 ms. Lowered in tests for a fast,
deterministic check."
Transaction class >> deadlockTimeoutMs        [ ^self _primDeadlockTimeoutMs ]
Transaction class >> deadlockTimeoutMs: anInt [ ^self _primSetDeadlockTimeoutMs: anInt ]

Transaction class >> atomic: aBlock [
    ^self new pvtRunAtomic: aBlock
]

Transaction >> initialize  [ status := #pending ]
Transaction >> status      [ ^status ]
Transaction >> isCommitted [ ^status = #committed ]
Transaction >> isAborted   [ ^status = #aborted ]

Transaction >> pvtRunAtomic: aBlock [
    | txf |
    txf := Future new.
    handle := self _primBeginAtomicTx.
    "Both outcomes are handled by ONE HandlerContext (handler-bind), so the async
     commit runs without a synchronous unwinding `on:do:` blocking the coordinator.
     OkToCommit's handler can `resume:` the commit point; Error's handler catches
     both signalled conditions (`tx abort`) and raw rejections surfaced through the
     condition system — including a Deadlock the detector injects into a parked
     reply — because `force_value`/`then:orElse:` route async rejections through
     `signal_condition`. The work future's rejection arm re-raises (`orElse:
     #signal`) into this same chain, so the Error handler is the single visible
     place collecting the transaction's failure behavior."
    (((HandlerContext new
        on: OkToCommit do: [:c | self pvtCommit. txf resolveWith: c value. c resume: c value])
        on: Error do: [:e | self pvtRollback. txf rejectWith: e]))
      run: [ | f |
        f := aBlock value: self.
        f then: [:val | (OkToCommit value: val) signal ] orElse: #signal ].
    ^TxResult transaction: self result: txf
]

Transaction >> pvtCommit [
    (self _primEnrolledParticipants: handle) do: [:p | (p pvtExitTx: #commit) await].
    self _primCommitSharedTx: handle.
    status := #committed
]

Transaction >> pvtRollback [
    (self _primEnrolledParticipants: handle) do: [:p | (p pvtExitTx: #rollback) await].
    self _primRollbackSharedTx: handle.
    status := #aborted
]

"Abort from within the block: signals an Error caught by the HandlerContext,
which rolls back and rejects the result future."
Transaction >> abort [ self error: 'transaction aborted' ]

"════════════════════════════════════════════════════════════════════════════
 Optimistic multi-entity transactions — #stm (C32)

 `Transaction stm: aBlock` runs aBlock optimistically: participants are NOT
 locked during the block (unrelated handlers interleave freely), and each records
 the version it had when the transaction first touched it. At commit a two-phase
 protocol try-locks and validates every participant; if any version changed (a
 concurrent handler mutated it) or is already locked, the whole transaction
 aborts and retries (up to `stmRetryLimit` times). Exhausting the retries rejects
 the result future with a `TxConflict`.
 ════════════════════════════════════════════════════════════════════════════"

"Raised when an `#stm` transaction cannot commit within its retry budget because
a concurrent mutation kept invalidating its optimistic read/write set. Being an
Error, it surfaces when the result future is awaited."
Error subclass: #TxConflict
    instanceVariableNames: ''
    classVariableNames: ''
    indexedSlots: #none.

"Participant-side phase-1 trampoline: try-lock + validate this participant for the
tagged transaction, voting commit (true) / abort (false)."
Object >> pvtStmPrepare [ ^self _primStmPrepare ]

"How many times an #stm transaction re-runs its block before giving up. Override
in a subclass for a different budget."
Transaction class >> stmRetryLimit [ ^3 ]

Transaction class >> stm: aBlock [
    ^self new pvtRunStm: aBlock
]

Transaction >> pvtRunStm: aBlock [
    | txf |
    txf := Future new.
    self pvtStmAttempt: aBlock result: txf retriesLeft: self class stmRetryLimit.
    ^TxResult transaction: self result: txf
]

Transaction >> pvtMarkCommitted [ status := #committed ]
Transaction >> pvtMarkAborted   [ status := #aborted ]

"One optimistic attempt, structured exactly like `pvtRunAtomic` so `stm:` is
*non-blocking*: the block's work future is chained with `then:` (never awaited in
the coordinator), so `pvtStmAttempt:` returns immediately and the commit runs in
the continuation. When the work resolves, `OkToCommit` is signalled and its
HandlerContext handler runs the two-phase commit:
  - committed → resolve the result future;
  - version conflict → retry with a fresh snapshot while budget remains, else
    reject with `TxConflict`.
A raw Error (including `tx abort`, or a rejected participant reply surfaced while
awaiting) is caught by the outer unwinding `on: Error do:`, which rolls back and
rejects — errors are not retried. Retry re-enters `pvtStmAttempt:` (fresh STM
level + fresh `then:`) from within the handler; `resume: nil` then ends the
signalling continuation."
Transaction >> pvtStmAttempt: aBlock result: txf retriesLeft: n [
    handle := self _primBeginStmTx.
    (((HandlerContext new
        on: OkToCommit do: [:c |
            (self pvtStmCommit)
              ifTrue:  [ self pvtMarkCommitted. txf resolveWith: c value ]
              ifFalse: [ n > 0
                  ifTrue:  [ self pvtStmAttempt: aBlock result: txf retriesLeft: n - 1 ]
                  ifFalse: [ self pvtMarkAborted.
                             txf rejectWith: (TxConflict withMessage: 'stm: retries exhausted') ] ].
            c resume: c value ])
        on: Error do: [:e | self pvtStmRollback. self pvtMarkAborted. txf rejectWith: e]))
      run: [ | f |
        f := aBlock value: self.
        f then: [:val | (OkToCommit value: val) signal ] orElse: #signal ]
]

"Two-phase commit. Phase 1: prepare (try-lock + validate) every participant.
If all vote commit, phase 2 applies each participant's writes to live slots,
unlocks, and commits the shared store transaction (returns true). Otherwise every
participant is released and the shared transaction rolls back (returns false)."
Transaction >> pvtStmCommit [
    | participants allOk |
    participants := self _primEnrolledParticipants: handle.
    "Contagious-atomic: a requested #stm coerced to atomic (nested under an atomic
     ancestor) commits pessimistically — no version validation, just apply and
     commit, exactly like a nested atomic child. It can never conflict."
    (self _primTxIsStm: handle) ifFalse: [
        participants do: [:p | (p pvtExitTx: #commit) await].
        self _primCommitSharedTx: handle.
        ^true ].
    "Optimistic path: prepare (try-lock + validate) each participant, folding the
     votes. `and:` short-circuits, so once one votes abort we stop locking further."
    allOk := participants inject: true into: [:acc :p | acc and: [ (p pvtStmPrepare) await ]].
    allOk
        ifTrue: [
            participants do: [:p | (p pvtExitTx: #commit) await].
            self _primCommitSharedTx: handle.
            ^true ]
        ifFalse: [
            participants do: [:p | (p pvtExitTx: #rollback) await].
            self _primRollbackSharedTx: handle.
            ^false ]
]

"Error-path rollback: release every participant (discarding its shadow) and roll
back the shared transaction."
Transaction >> pvtStmRollback [
    (self _primEnrolledParticipants: handle) do: [:p | (p pvtExitTx: #rollback) await].
    self _primRollbackSharedTx: handle
]
