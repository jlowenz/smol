"ValueHolder - an actor that holds a single mutable value reference"
Object subclass: #ValueHolder instanceVariableNames: 'val'.
ValueHolder class >> initialValue: aVal [
    ^ValueHolder new set: aVal; yourself
]
ValueHolder >> set: aVal [ val := aVal ]
ValueHolder >> get [ ^val ]
"Takes aBlock that accepts the old value and returns an updated value"
ValueHolder >> update: aBlock [
    self set: (aBlock value: self get)
]

"Array — fixed-size indexed collection of pointer slots."
Object subclass: #Array
    instanceVariableNames: ''
    classVariableNames: ''
    indexedSlots: #pointer.

Array >> at: i       [ ^self _primAt: i ]
Array >> at: i put: v [ self _primAt: i put: v. ^v ]
Array >> size        [ ^self _primSize ]
Array >> isEmpty     [ ^self _primSize = 0 ]
Array >> notEmpty    [ ^self _primSize > 0 ]
Array >> first       [ ^self _primAt: 0 ]
Array >> last        [ ^self _primAt: self _primSize - 1 ]

Array >> do: aBlock [
    0 to: (self _primSize - 1) do: [ :i |
        aBlock value: (self _primAt: i)
    ]
]

Array >> collect: aBlock [
    | result |
    result := Array new: self _primSize.
    0 to: (self _primSize - 1) do: [ :i |
        result at: i put: (aBlock value: (self _primAt: i))
    ]
    ^result
]

Array >> select: aBlock [
    | result |
    result := OrderedCollection new.
    self do: [:each | (aBlock value: each) ifTrue: [result add: each]].
    ^result
]

Array >> reject: aBlock [
    | result |
    result := OrderedCollection new.
    self do: [:each | (aBlock value: each) ifFalse: [result add: each]].
    ^result
]

Array >> detect: aBlock [
    self do: [:each | (aBlock value: each) ifTrue: [^each]].
    self error: 'detect: no element satisfies the condition'
]

Array >> detect: aBlock ifNone: noneBlock [
    self do: [:each | (aBlock value: each) ifTrue: [^each]].
    ^noneBlock value
]

Array >> inject: init into: aBlock [
    | holder |
    holder := ValueHolder initialValue: init.
    ^[self do: [:each |
        holder update: [:acc | aBlock value: acc value: each]
    ]] then: [:done | holder get] orElse: #reject
]

Array >> includes: v [
    self do: [:each | each = v ifTrue: [^true]].
    ^false
]

Array >> copyFrom: start to: stop [
    | result |
    result := Array new: stop - start + 1.
    0 to: stop - start do: [:i |
        result at: i put: (self _primAt: start + i)
    ].
    ^result
]

Array >> = other [
    | n |
    self class = other class ifFalse: [^false].
    n := self _primSize.
    n = other size ifFalse: [^false].
    0 to: n - 1 do: [ :i |
        (self _primAt: i) = (other at: i) ifFalse: [^false].
    ].
    ^true
]

Array >> ~= other [ ^(self = other) not ]

Array >> printString [
    | holder |
    holder := ValueHolder initialValue: '('.
    ^[self do: [:each |
        holder update: [:s | s , each printString , ' ']
    ]] then: [:done | holder get , ')'] orElse: #reject
]

"ByteArray — fixed-size indexed collection of byte (0..255) slots."
Object subclass: #ByteArray
    instanceVariableNames: ''
    classVariableNames: ''
    indexedSlots: #byte.

ByteArray >> at: i       [ ^self _primAt: i ]
ByteArray >> at: i put: v [ self _primAt: i put: v. ^v ]
ByteArray >> size        [ ^self _primSize ]
ByteArray >> isEmpty     [ ^self _primSize = 0 ]
ByteArray >> notEmpty    [ ^self _primSize > 0 ]

ByteArray >> do: aBlock [
    0 to: self _primSize - 1 do: [:i |
        aBlock value: (self _primAt: i)
    ]
]

ByteArray >> copyFrom: start to: stop [
    | result |
    result := ByteArray new: stop - start + 1.
    0 to: stop - start do: [:i |
        result at: i put: (self _primAt: start + i)
    ].
    ^result
]

ByteArray >> asString [ ^self _primAsString ]

ByteArray >> printString [
    | holder |
    holder := ValueHolder initialValue: '('.
    ^[self do: [:each |
        holder update: [:s | s , each printString , ' ']
    ]] then: [:done | holder get , ')'] orElse: #reject
]

"OrderedCollection — growable sequence backed by an Array."
Object subclass: #OrderedCollection
    instanceVariableNames: 'storage size'
    classVariableNames: ''
    indexedSlots: #none.

OrderedCollection >> initialize [
    storage := Array new: 8.
    size := 0
]

OrderedCollection >> size        [ ^size ]
OrderedCollection >> isEmpty     [ ^size = 0 ]
OrderedCollection >> notEmpty    [ ^size > 0 ]
OrderedCollection >> first       [ ^self at: 0 ]
OrderedCollection >> last        [ ^self at: size - 1 ]

OrderedCollection >> at: i [
    (i < 0 or: [i >= size]) ifTrue: [self error: 'at: index out of bounds'].
    ^storage at: i
]

OrderedCollection >> at: i put: v [
    (i < 0 or: [i >= size]) ifTrue: [self error: 'at:put: index out of bounds'].
    storage at: i put: v.
    ^v
]

OrderedCollection >> add: v [
    size >= storage size ifTrue: [self pvtGrow].
    storage at: size put: v.
    size := size + 1.
    ^v
]

OrderedCollection >> addLast: v [ ^self add: v ]

OrderedCollection >> addFirst: v [
    size >= storage size ifTrue: [self pvtGrow].
    size to: 1 by: -1 do: [:i |
        storage at: i put: (storage at: i - 1)
    ].
    storage at: 0 put: v.
    size := size + 1.
    ^v
]

OrderedCollection >> removeFirst [
    | v |
    size = 0 ifTrue: [self error: 'removeFirst: collection is empty'].
    v := storage at: 0.
    1 to: size - 1 do: [:i |
        storage at: i - 1 put: (storage at: i)
    ].
    size := size - 1.
    ^v
]

OrderedCollection >> removeLast [
    | v |
    size = 0 ifTrue: [self error: 'removeLast: collection is empty'].
    v := storage at: size - 1.
    size := size - 1.
    ^v
]

OrderedCollection >> pvtRemoveAt: idx [
    idx + 1 to: size - 1 do: [:j |
        storage at: j - 1 put: (storage at: j)
    ].
    size := size - 1
]

OrderedCollection >> remove: v ifAbsent: aBlock [
    0 to: size - 1 do: [:i |
        (storage at: i) = v ifTrue: [
            (self pvtRemoveAt: i) then: [:done | ^v] orElse: #reject
        ]
    ].
    ^aBlock value
]

OrderedCollection >> do: aBlock [
    0 to: size - 1 do: [:i |
        aBlock value: (storage at: i)
    ]
]

OrderedCollection >> collect: aBlock [
    | result |
    result := OrderedCollection new.
    0 to: size - 1 do: [:i |
        result add: (aBlock value: (storage at: i))
    ].
    ^result
]

OrderedCollection >> select: aBlock [
    | result |
    result := OrderedCollection new.
    self do: [:each | (aBlock value: each) ifTrue: [result add: each]].
    ^result
]

OrderedCollection >> reject: aBlock [
    | result |
    result := OrderedCollection new.
    self do: [:each | (aBlock value: each) ifFalse: [result add: each]].
    ^result
]

OrderedCollection >> detect: aBlock [
    self do: [:each | (aBlock value: each) ifTrue: [^each]].
    self error: 'detect: no element satisfies the condition'
]

OrderedCollection >> detect: aBlock ifNone: noneBlock [
    self do: [:each | (aBlock value: each) ifTrue: [^each]].
    ^noneBlock value
]

OrderedCollection >> inject: init into: aBlock [
    | holder |
    holder := ValueHolder initialValue: init.
    ^[self do: [:each |
        holder update: [:acc | aBlock value: acc value: each]
    ]] then: [:done | holder get] orElse: #reject
]

OrderedCollection >> includes: v [
    self do: [:each | each = v ifTrue: [^true]].
    ^false
]

OrderedCollection >> copyFrom: start to: stop [
    | result |
    result := OrderedCollection new.
    start to: stop do: [:i |
        result add: (self at: i)
    ].
    ^result
]

OrderedCollection >> = other [
    self class = other class ifFalse: [^false].
    size = other size ifFalse: [^false].
    0 to: size - 1 do: [:i |
        (self at: i) = (other at: i) ifFalse: [^false]
    ].
    ^true
]

OrderedCollection >> ~= other [ ^(self = other) not ]

OrderedCollection >> printString [
    | holder |
    holder := ValueHolder initialValue: 'OrderedCollection ('.
    ^[self do: [:each |
        holder update: [:s | s , each printString , ' ']
    ]] then: [:done | holder get , ')'] orElse: #reject
]

OrderedCollection >> pvtGrow [
    | newStorage |
    newStorage := Array new: storage size * 2.
    0 to: size - 1 do: [:i |
        newStorage at: i put: (storage at: i)
    ].
    storage := newStorage
]


"Default hash delegates to _primHash (identity-based pointer hash).
 Subclasses that override = for value equality must also override hash
 to maintain the invariant: a = b → a hash = b hash."
Object >> hash [ ^self _primHash ]

"Default initialize is a no-op."
Object >> initialize []

"Default isEmpty returns false; collection subclasses override."
Object >> isEmpty [ ^false ]

Object >> class [ ^self _primClass ]
Object >> isKindOf: aClass [ ^self _primIsKindOf: aClass ]

"Default handling of a send that failed normal lookup: signal a
MessageNotUnderstood condition carrying the reified message. Override in a
subclass to intercept/forward arbitrary messages (proxies, transparent futures).
The interpreter invokes this via the DNU hook in dispatch_to_stack /
dispatch_envelope; see docs/chunk_33_plan.md."
Object >> doesNotUnderstand: aMessage [
    ^(MessageNotUnderstood receiver: self message: aMessage) signal
]

Object class >> new [
    ^[self _primNew initialize] syncValue
]

Object class >> new: n [
    ^[(self _primNew: n) initialize] syncValue
]

"Value class >> new freezes the instance after initialize."
Value class >> new [
    ^self _primNewValue: [:inst | inst initialize]
]

Value class >> new: n [
    ^self _primNewValueIndexed: n init: [:inst | inst initialize]
]

"Association — immutable key / mutable value pair."
Value subclass: #Association
    instanceVariableNames: 'key value'
    classVariableNames: ''
    indexedSlots: #none.

Association class >> key: k value: v [
    ^self _primNewValue: [:a | a pvtKey: k value: v]
]

Association >> pvtKey: k value: v [ key := k. value := v ]
Association >> key      [ ^key ]
Association >> value    [ ^value ]
Association >> value: v [ ^self class key: key value: v ]
Association >> = other [
    self class = other class ifFalse: [^false].
    ^key = other key
]
Association >> printString [
    ^key printString , ' -> ' , value printString
]

"Shorthand for building Associations via binary message -> ."
Object >> -> aVal [ ^Association key: self value: aVal ]

"Trait — a stateless, first-class unit of behavioral reuse (docs/traits_plan.md).
 The `data` ivar holds the native TraitData payload (method dict + provenance).
 The +/-/@ algebra builds fresh traits; requirements are derived from method bodies."
Value subclass: #Trait
    instanceVariableNames: 'data'
    classVariableNames: ''
    indexedSlots: #none.

"Create an empty named trait; extend it with `aTrait >> selector [...]`."
Trait class >> named: n [ ^self _primNewTrait: n ]

"Name a trait built from a composition expression; binds the name in scope."
Trait class >> named: n from: aTrait [ ^self _primDefineTrait: n from: aTrait ]

"Sum / union. Conflicting selectors (differing provenance) become conflict markers."
Trait >> + other [ ^self _primTraitSum: other ]

"Exclusion. Right operand is polymorphic: a Trait (drop its provided selectors)
 or an Array of Symbols (drop that explicit selector set)."
Trait >> - arg [
    (arg isKindOf: Trait) ifTrue: [^self _primTraitExcludeTrait: arg].
    ^self _primTraitExcludeSelectors: arg
]

"Aliasing: add entry points. Argument is an Array of Associations #newSel -> #oldSel."
Trait >> @ aliases [ ^self _primTraitAlias: aliases ]

Trait >> name          [ ^self _primTraitName ]
Trait >> requirements  [ ^self _primTraitRequirements ]
Trait >> conflicts     [ ^self _primTraitConflicts ]
Trait >> printString   [ ^'Trait(' , self _primTraitName printString , ')' ]

"Cons — immutable singly-linked list node.
 nil is the empty list; isNil / isEmpty are the emptiness checks."
Value subclass: #Cons
    instanceVariableNames: 'head tail'
    classVariableNames: ''
    indexedSlots: #none.

Cons class >> with: anObject rest: aList [
    ^self _primNewValue: [:c |
        c pvtHead: anObject tail: aList.
    ]
]

Cons class >> singleton: anObject [
    ^self _primNewValue: [:c |
        c pvtHead: anObject tail: nil.
    ]
]

Cons >> pvtHead: h tail: t [ head := h. tail := t. ]
Cons >> head           [ ^head ]
Cons >> tail           [ ^tail ]
Cons >> isEmpty        [ ^false ]

Cons >> addFirst: x [ ^Cons with: x rest: self ]

Cons >> do: aBlock [
    aBlock value: head.
    tail isNil ifFalse: [tail do: aBlock]
]

Cons >> size [
    ^1 + (tail isNil ifTrue: [0] ifFalse: [tail size])
]

Nil >> isEmpty [ ^true ]
Nil >> do: aBlock [ ^nil ]
Nil >> inject: aValue into: aBlock [ ^aValue ]

Cons >> inject: aValue into: aBlock [
    ^tail inject: (aBlock value: aValue value: head) into: aBlock
]

"Message — a reified send: the selector and arguments of a message that failed
 normal lookup, handed to `doesNotUnderstand:`. Constructed by the interpreter at
 the DNU site (see build_message in eval_iterative.rs); `arguments` is a Cons list
 (nil for a unary/0-arg send). A Value so it is immutable and freely shareable."
Value subclass: #Message
    instanceVariableNames: 'selector arguments'
    classVariableNames: ''
    indexedSlots: #none.

Message >> selector       [ ^selector ]
Message >> arguments      [ ^arguments ]
Message >> argumentCount  [ ^arguments isNil ifTrue: [0] ifFalse: [arguments size] ]
Message >> sendTo: anObject [ ^anObject perform: selector withArguments: arguments ]

"Dictionary — open-addressing hash map over a flat Array of Association slots.
 Initial capacity 8; rehashes at 75% load by doubling."
Object subclass: #Dictionary
    instanceVariableNames: 'table size'
    classVariableNames: ''
    indexedSlots: #none.

Dictionary >> initialize [
    table := Array new: 8.
    size := 0
]

"Returns the slot index for key — nil slot means absent, matching slot means present."
Dictionary >> pvtSlotFor: key [
    | cap h i |
    cap := table size.
    h := key hash \\ cap.
    i := h < 0 ifTrue: [h + cap] ifFalse: [h].
    i to: (i + table size - 1) do: [ :i | 
        |slot j|
        j := i \\ cap. 
        slot := table at: j.
        (slot isNil or: [slot key = key]) ifTrue: [^j]
    ]
]

Dictionary >> at: key put: value [
    | i slot |
    (size * 4) >= (table size * 3) ifTrue: [self pvtRehash].
    i := self pvtSlotFor: key.
    slot := table at: i.
    size := slot isNil
        ifTrue: [
            table at: i put: (Association key: key value: value).
            size + 1]
        ifFalse: [
            table at: i put: (Association key: key value: value).
            size].
    ^value
]

Dictionary >> at: key [
    ^self at: key ifAbsent: [Error signal: 'key not found']
]

Dictionary >> at: key ifAbsent: aBlock [
    | i slot |
    i := self pvtSlotFor: key.
    slot := table at: i.
    slot isNil ifTrue: [^aBlock value].
    ^slot value
]

Dictionary >> includesKey: key [
    | slot |
    slot := table at: (self pvtSlotFor: key).
    ^slot notNil
]

"Removes key; returns value if present, block result if absent.
 Uses full-table rebuild to preserve open-addressing invariants."
Dictionary >> removeKey: key ifAbsent: aBlock [
    | i slot removedValue oldTable oldSize |
    i := self pvtSlotFor: key.
    slot := table at: i.
    slot isNil ifTrue: [^aBlock value].
    removedValue := slot value.
    oldTable := table.
    oldSize := oldTable size.
    table := Array new: oldSize.
    size := 0.
    0 to: oldSize - 1 do: [:i |
        (oldTable at: i) ifNotNil: [:s |
            (s key ~= key) ifTrue: [self at: s key put: s value]
        ]
    ].
    ^removedValue
]

Dictionary >> size     [ ^size ]
Dictionary >> isEmpty  [ ^size = 0 ]
Dictionary >> notEmpty [ ^size > 0 ]

Dictionary >> do: aBlock [
    | cap |
    cap := table size.
    0 to: cap - 1 do: [:i |
        (table at: i) ifNotNil: [:slot | aBlock value: slot value]
    ]
]

Dictionary >> keysDo: aBlock [
    | cap |
    cap := table size.
    0 to: cap - 1 do: [:i |
        (table at: i) ifNotNil: [:slot | aBlock value: slot key]
    ]
]

Dictionary >> associationsDo: aBlock [
    | cap |
    cap := table size.
    0 to: cap - 1 do: [:i |
        (table at: i) ifNotNil: [:slot | aBlock value: slot]
    ]
]

Dictionary >> keys [
    | result |
    result := OrderedCollection new.
    self keysDo: [:k | result add: k].
    ^result
]

Dictionary >> values [
    | result |
    result := OrderedCollection new.
    self do: [:v | result add: v].
    ^result
]

Dictionary >> = other [
    self class = other class ifFalse: [^false].
    size = other size ifFalse: [^false].
    self associationsDo: [:assoc |
        (other at: assoc key ifAbsent: [^false]) = assoc value
            ifFalse: [^false]
    ].
    ^true
]

Dictionary >> printString [
    | holder |
    holder := ValueHolder initialValue: 'Dictionary ('.
    ^[self associationsDo: [:assoc |
        holder update: [:s | s , assoc printString , ' ']
    ]] then: [:done | holder get , ')'] orElse: #reject
]

Dictionary >> pvtRehash [
    | old |
    old := table.
    table := Array new: old size * 2.
    size := 0.
    0 to: old size - 1 do: [:i |
        (old at: i) ifNotNil: [:slot | self at: slot key put: slot value]
    ]
]

"Condition hierarchy — CL-inspired non-local condition/restart system."

Value subclass: #Condition
    instanceVariableNames: 'message restarts'
    classVariableNames: ''
    indexedSlots: #none.

Condition class >> withMessage: aString [
    ^self _primNewValue: [:c |
        c pvtSetMessage: aString
    ]
]

"Factory for functional updates: preserves polymorphism across Condition subclasses."
Condition class >> pvtMessage: msg restarts: r [
    ^self _primNewValue: [:c |
        c pvtSetMessage: msg.
        c pvtSetRestarts: r
    ]
]

Condition class >> signal: aString [ ^(self withMessage: aString) signal ]

"restarts is a Cons-of-Association (or nil). Frozen after construction."
Condition >> initialize         [ message := '' ]
Condition >> pvtSetMessage: s   [ message := s ]
Condition >> pvtSetRestarts: r  [ restarts := r ]
Condition >> message            [ ^message ]
Condition >> messageText        [ ^message ]

"Returns a new Condition with this restart prepended; self is unchanged (frozen)."
Condition >> addRestart: name block: aBlock [
    ^self class pvtMessage: message restarts: (Cons with: (name -> aBlock) rest: restarts)
]

Condition >> pvtFindRestart: name in: node [
    node isNil ifTrue: [^nil].
    node head key = name ifTrue: [^node head value].
    ^self pvtFindRestart: name in: node tail
]

Condition >> hasRestart: name [ ^(self pvtFindRestart: name in: restarts) notNil ]
Condition >> availableRestarts [ ^#() ]

"Run the named restart block, passing it the condition so it may perform its own
transfer (`c return:` / `c resume:` / `c retry`). A transfer unwinds before the
enclosing `resume:` runs, so the block's choice wins; a block that completes
normally defaults to resuming with its value."
Condition >> invokeRestart: name [
    | blk |
    blk := self pvtFindRestart: name in: restarts.
    blk isNil ifTrue: [self error: 'no restart named: ', name].
    ^self resume: (blk value: self)
]

Condition >> invokeRestart: name with: arg [
    | blk |
    blk := self pvtFindRestart: name in: restarts.
    blk isNil ifTrue: [self error: 'no restart named: ', name].
    ^self resume: (blk value: self value: arg)
]

Condition >> signal    [ ^self _primSignalCondition: self ]
Condition >> resume: v [ ^self _primResume: v ]
Condition >> return: v [ ^self _primReturn: v ]
Condition >> retry     [ ^self _primRetry ]

"Resumability (guide §2): whether a handler that completes without an explicit
restart resumes (true) or aborts (false). This is a *class-level* policy keyed on
the class named at the handler site (`on: SomeClass do:` / `HandlerContext on:
SomeClass do:`), NOT the concrete class of the signalled instance — so a handler
declared for `Error` always aborts, even for a resumable `Error` subclass. The
signal machinery reads this class-side predicate (constant-folded, so it must
return a literal `true`/`false`). `Condition` is resumable; `Error` overrides to
non-resumable. The instance-side method delegates for Smol ergonomics."
Condition class >> isResumable [ ^true ]
Condition >> isResumable       [ ^self class isResumable ]

Condition subclass: #Warning
    instanceVariableNames: ''
    classVariableNames: 'LoggingPolicy'
    indexedSlots: #none.

Warning class >> initialize         [ LoggingPolicy := #stderr ]
Warning class >> loggingPolicy: sym [ LoggingPolicy := sym ]
Warning class >> loggingPolicy      [ ^LoggingPolicy ]

Condition subclass: #Error
    instanceVariableNames: ''
    classVariableNames: ''
    indexedSlots: #none.

Error class >> isResumable [ ^false ]

"Signaled when resolveWith:/rejectWith: is sent to an already-settled Future.
Carries an #ignore restart so a handler can choose to keep the first resolution."
Error subclass: #FutureAlreadyResolved
    instanceVariableNames: ''
    classVariableNames: ''
    indexedSlots: #none.

"Signaled by the default Object>>doesNotUnderstand: when a send fails normal
lookup. Carries the receiver and the reified failed Message. A handler may
`resume:` (or `return:`) a value to substitute for the failed send's result."
Error subclass: #MessageNotUnderstood
    instanceVariableNames: 'receiver failedMessage'
    classVariableNames: ''
    indexedSlots: #none.

MessageNotUnderstood class >> receiver: r message: m [
    ^self _primNewValue: [:c | c pvtSetReceiver: r message: m]
]

MessageNotUnderstood >> pvtSetReceiver: r message: m [
    receiver := r.
    failedMessage := m.
    self pvtSetMessage: 'does not understand #', m selector asString
]

MessageNotUnderstood >> receiver      [ ^receiver ]
MessageNotUnderstood >> failedMessage [ ^failedMessage ]

"Signaled (by the interpreter's deadlock detector, C31 S5c) inside a transaction
coordinator whose participants are caught in a wait-for cycle. Being an Error, it
is caught by the transaction's `on: Error do:` handler, which rolls back and
releases the victim's locks so the rest of the cycle proceeds."
Error subclass: #Deadlock
    instanceVariableNames: ''
    classVariableNames: ''
    indexedSlots: #none.

"Signaled when a class inherits an unresolved trait conflict (two composed traits
provide the same selector with differing provenance) and that selector is sent
without a class-defined override. Carries the offending selector."
Error subclass: #TraitConflict
    instanceVariableNames: 'selector'
    classVariableNames: ''
    indexedSlots: #none.

TraitConflict class >> selector: sel [
    ^self _primNewValue: [:c | c pvtSetSelector: sel]
]
TraitConflict >> pvtSetSelector: sel [
    selector := sel.
    self pvtSetMessage: 'unresolved trait conflict: #', sel asString
]
TraitConflict >> selector [ ^selector ]

"Sentinel entry point installed for an unresolved trait conflict; raises when sent."
Object >> pvtTraitConflictFor: sel [ ^(TraitConflict selector: sel) signal ]

"HandlerContext — non-unwinding handler registration (CL handler-bind analog).
pairs is a Cons-of-Association linked list (or nil):
  Cons(head: cls -> blk, tail: rest)
Newest pair is at the head.

HandlerContext is a Value (synchronous dispatch): `run:` and the handlers it
registers execute in the *caller's* coroutine, not a separate actor's. This is
required — an entity HandlerContext would be enqueued/auto-enrolled when used
inside a transaction, and its `pairs` write would land in a shadow frame while
`_primHCRun:` reads the live slot, losing the handlers. Being a Value, `on:do:`
is functional (returns a new HandlerContext with the pair prepended) since the
instance is frozen after construction."
Value subclass: #HandlerContext
    instanceVariableNames: 'pairs'
    classVariableNames: ''
    indexedSlots: #none.

HandlerContext >> initialize       [ pairs := nil ]
HandlerContext >> pvtSetPairs: c   [ pairs := c ]
HandlerContext >> pairs            [ ^pairs ]

HandlerContext class >> pvtPairs: aCons [
    ^self _primNewValue: [:hc | hc pvtSetPairs: aCons]
]

"Functional: returns a new HandlerContext with (cls -> blk) prepended."
HandlerContext >> on: cls do: blk  [
    ^HandlerContext pvtPairs: (Cons with: (cls -> blk) rest: pairs)
]

"Register all (cls -> blk) associations from anArray in one go, then run body.
Folds with inject:into: (no in-place mutation, since self is frozen)."
HandlerContext >> on: anArray run: body [
    ^(anArray inject: self into: [:hc :assoc | hc on: assoc key do: assoc value]) run: body
]

HandlerContext >> run: body        [ ^self _primHCRun: body ]

"Numeric tower & scalar value classes (docs/numeric_tower_plan.md).
All are encodings of Value instances, reparented under Value so `isKindOf: Value`
holds. Representation runs down the is-a spine: MachineInteger = Value::Int(i64),
ArbitraryInteger = Value::LargeInt(BigInt), Float = Value::Float(f64). Integer is the
abstract shared class (bare `Int` retired); integer literals produce MachineInteger,
promoting to ArbitraryInteger on overflow. String/Symbol are direct Value leaves (not
Magnitudes). Reflection is routed via lookup_user_method arms + value_to_class_handle.
S1a: ordinary subclass:; the encoded leaves become vmSubclass: (closed) in S1b.
Arithmetic still lives in the Rust primitive layer (dispatch_int/dispatch_float);
S2–S4 move the protocol into Smol on these classes."

Value subclass: #Magnitude
    instanceVariableNames: ''
    classVariableNames: ''
    indexedSlots: #none.

Magnitude subclass: #Number
    instanceVariableNames: ''
    classVariableNames: ''
    indexedSlots: #none.

Number subclass: #Integer
    instanceVariableNames: ''
    classVariableNames: ''
    indexedSlots: #none.

"The encoded leaves (fixed native Value representation) are defined with
vmSubclass:, marking them closed — `subclass:` on them is rejected. The abstract
tower classes above (Magnitude/Number/Integer) stay open ordinary subclasses."

Integer vmSubclass: #MachineInteger
    instanceVariableNames: ''
    classVariableNames: ''
    indexedSlots: #none.

Integer vmSubclass: #ArbitraryInteger
    instanceVariableNames: ''
    classVariableNames: ''
    indexedSlots: #none.

Number vmSubclass: #Float
    instanceVariableNames: ''
    classVariableNames: ''
    indexedSlots: #none.

Value vmSubclass: #String
    instanceVariableNames: ''
    classVariableNames: ''
    indexedSlots: #none.

Value vmSubclass: #Symbol
    instanceVariableNames: ''
    classVariableNames: ''
    indexedSlots: #none.

"Boolean hierarchy — True and False are singleton-style classes.
Value::Bool(b) is the runtime representation; Bool is routed through
lookup_user_method so these methods are found at step (1) of dispatch_to_stack."

Value subclass: #Boolean
    instanceVariableNames: ''
    classVariableNames: ''
    indexedSlots: #none.

Boolean vmSubclass: #True
    instanceVariableNames: ''
    classVariableNames: ''
    indexedSlots: #none.

Boolean vmSubclass: #False
    instanceVariableNames: ''
    classVariableNames: ''
    indexedSlots: #none.

True  >> ifTrue: aBlock             [ ^aBlock value ]
True  >> ifFalse: aBlock            [ ^nil ]
True  >> ifTrue: t ifFalse: f       [ ^t value ]
True  >> ifFalse: f ifTrue: t       [ ^t value ]
True  >> and: aBlock                [ ^aBlock value ]
True  >> or: aBlock                 [ ^true ]
True  >> not                        [ ^false ]
True  >> xor: aBool                 [ ^aBool not ]
True  >> printString                [ ^'true' ]
True  >> = other                    [ ^other isKindOf: True ]
True  >> & other                    [ ^other ]
True  >> | other                    [ ^true ]

False >> ifTrue: aBlock             [ ^nil ]
False >> ifFalse: aBlock            [ ^aBlock value ]
False >> ifTrue: t ifFalse: f       [ ^f value ]
False >> ifFalse: f ifTrue: t       [ ^f value ]
False >> and: aBlock                [ ^false ]
False >> or: aBlock                 [ ^aBlock value ]
False >> not                        [ ^true ]
False >> xor: aBool                 [ ^aBool not ]
False >> printString                [ ^'false' ]
False >> = other                    [ ^other isKindOf: False ]
False >> & other                    [ ^false ]
False >> | other                    [ ^other ]

Boolean >> ~= other                 [ ^(self = other) not ]

"Loop — pure Smol recursive implementations enabled by inline block dispatch and
TCO in the iterative evaluator. The _prim* builtins in builtins.rs remain as
direct fallbacks for the old (recursive) evaluator, which reaches them via the
aliased 'whileTrue:'/'_primWhileTrue:' match arms without going through these
Smol methods."

Block >> whileTrue: aBlock [
    self value ifFalse: [ ^nil ].
    aBlock value.
    ^self whileTrue: aBlock
]

Block >> whileFalse: aBlock [
    self value ifTrue: [ ^nil ].
    aBlock value.
    ^self whileFalse: aBlock
]

Block >> whileTrue [
    self value ifFalse: [ ^nil ].
    ^self whileTrue
]

Block >> whileFalse [
    self value ifTrue: [ ^nil ].
    ^self whileFalse
]

"timesRepeat: recurses on (self - 1) instead of mutating a counter variable,
avoiding NonLocalBlockAssignment. The iterative evaluator handles this O(1) via
TCO; the old evaluator uses the _primTimesRepeat: alias in dispatch_int directly."
Integer >> timesRepeat: aBlock [
    self > 0 ifFalse: [ ^nil ].
    aBlock value.
    ^(self - 1) timesRepeat: aBlock
]

"── Duration ─────────────────────────────────────────────────────────────────"
"Immutable millisecond-granularity time span.  No arithmetic or comparison."
Value subclass: #Duration
    instanceVariableNames: 'ms'
    classVariableNames: ''
    indexedSlots: #none.

Duration class >> ms: n      [ ^self _primNewValue: [:d | d pvtMs: n] ]
Duration class >> s: n       [ ^self _primNewValue: [:d | d pvtMs: n * 1000] ]
Duration class >> minutes: n [ ^self _primNewValue: [:d | d pvtMs: n * 60000] ]
Duration >> pvtMs: n         [ ms := n ]
Duration >> asMilliseconds   [ ^ms ]
Duration >> printString      [ ^ms printString, 'ms' ]

"── Timer ────────────────────────────────────────────────────────────────────"
"Cancellable one-shot timer.  Value object; immutable after construction."
Value subclass: #Timer
    instanceVariableNames: 'handle block'
    classVariableNames: ''
    indexedSlots: #none.

Timer class >> after: duration do: userBlock [
    | ms |
    ms := duration asMilliseconds.
    ^self _primNewValue: [:t |
        t pvtBlock: userBlock.
        t pvtHandle: (self _primScheduleTimer: ms block: [t pvtTimerFired])
    ]
]

Timer >> pvtBlock: b   [ block := b ]
Timer >> pvtHandle: h  [ handle := h ]
Timer >> pvtTimerFired [ ^block value ]
Timer >> cancel        [ self _primCancelTimer: handle ]
Timer >> isPending     [ ^self _primTimerPending: handle ]

"── TCP sockets (C-web spike) ─────────────────────────────────────────────────"
"Passive value wrappers over opaque OS socket handles (same shape as Timer). The
 `accept`/`read`/`write:` prims run their parking I/O on a fresh coroutine and
 answer a Future, so the async-everywhere model holds — chain with `then:orElse:`."

Value subclass: #TcpSocket
    instanceVariableNames: 'handle'
    classVariableNames: ''
    indexedSlots: #none.

TcpSocket class >> pvtWrapping: h [ ^self _primNewValue: [:s | s pvtHandle: h] ]
TcpSocket >> pvtHandle: h    [ handle := h ]
TcpSocket >> read            [ ^self _primTcpRead: handle ]          "Future of Str; '' = EOF"
TcpSocket >> write: aString  [ ^self _primTcpWrite: handle with: aString ]  "Future of Int"
TcpSocket >> close           [ ^self _primTcpClose: handle ]

Value subclass: #TcpListener
    instanceVariableNames: 'handle'
    classVariableNames: ''
    indexedSlots: #none.

TcpListener class >> onPort: port [
    ^self _primNewValue: [:l | l pvtHandle: (self _primTcpListen: port)]
]
TcpListener >> pvtHandle: h [ handle := h ]
"Answer a Future of the next inbound TcpSocket; rejection propagates down-chain.
 the resolved handle is passed to the `then:` block (1-arg)."
TcpListener >> accept [
    ^(self _primTcpAccept: handle) then: [:h | TcpSocket pvtWrapping: h] orElse: #reject
]

"── World ────────────────────────────────────────────────────────────────────"
"Environment-level queries over the live entity registry."
Object subclass: #World
    instanceVariableNames: ''
    classVariableNames: ''
    indexedSlots: #none.

World class >> instancesOf: aClass [
    ^self _primInstancesOf: aClass
]

"════════════════════════════════════════════════════════════════════════════
 Multi-entity atomic transactions (C31)

 `Transaction atomic: aBlock` runs aBlock as a single atomic unit, passing the
 transaction as the block argument. Tagged work messages the block sends to other
 entities cause those entities to auto-enroll (lock their mailbox + shadow their
 writes). On success the coordinator tells every participant to apply its writes,
 then commits the shared store transaction; on error (or `tx abort`) it tells them
 to discard and rolls back.

 `atomic:` returns immediately with a `TxResult` (the Transaction + a pending
 result future). The block runs under a HandlerContext: when the block's work
 future resolves, a `then:` continuation signals `OkToCommit`, whose handler runs
 the commit and resolves the result; any `Error` (including `tx abort`) is caught
 by the same HandlerContext, which rolls back and rejects the result. Because the
 continuation carries the coordinator's entity id, `self pvtCommit`/`pvtRollback`
 are sync self-sends — they do not enqueue tagged messages back to the coordinator
 (which would wrongly enroll it in its own transaction).

 Contract: the block must sequence (chain/await) the participant work it wants
 included, so the future it yields resolves only after all participants have
 enrolled. Async-participant error propagation (vs. synchronous block errors) is
 not yet covered — see OQ-C31-1 / docs.
 ════════════════════════════════════════════════════════════════════════════"

"Explicit Future: reifies an implicit future so code can create one, hand it
around, and resolve/reject it later. The wrapping is an implementation detail —
clients use `await` (blocks until resolved, like any implicit future) and
`resolveWith:`/`rejectWith:`; the internal handle is never exposed. A Future is a
Value and so is freely shareable across entities/threads; resolution is
single-winner — the first `resolveWith:`/`rejectWith:` wins and any later attempt
signals an error."
Value subclass: #Future
    instanceVariableNames: 'handle'
    classVariableNames: ''
    indexedSlots: #none.

Future class >> new [ ^self _primNewValue: [:f | f pvtInit] ]
Future >> pvtInit          [ handle := self _primNewFutureHandle ]
Future >> await            [ ^handle await ]
"Total async chaining: run `tb` on resolution, `eb` on rejection. `eb` is a 1-arg
block OR a symbol idiom — #signal (re-raise into the current handler chain),
#reject (propagate the rejection down the chain), #value (resolve with the
condition as a plain value). Bare `then:` was removed: the rejection arm must be
stated so it cannot be silently dropped."
Future >> then: tb orElse: eb [ ^handle then: tb orElse: eb ]
Future >> resolveWith: v   [ ^self pvtSettle: (self _primResolveFuture: handle value: v) ]
Future >> rejectWith: e    [ ^self pvtSettle: (self _primRejectFuture: handle error: e) ]

"Seamless forwarding: any message an explicit Future does not itself understand
implicitly awaits resolution and is re-sent to the resolved value — so an
explicit Future behaves like an implicit one (which the evaluator force-resolves
at every use point). await/then:orElse:/resolveWith:/rejectWith: act on the wrapper
and are handled above; everything else forwards here."
Future >> doesNotUnderstand: aMessage [ ^aMessage sendTo: handle await ]

"Single-winner guard: if the prim reports the future was already settled, signal a
typed, restartable condition. Handlers may `invokeRestart: #ignore` to keep the
existing resolution (the late attempt becomes a no-op returning nil)."
Future >> pvtSettle: won [
    won ifTrue: [ ^self ].
    ^((FutureAlreadyResolved withMessage: 'future already resolved')
        addRestart: #ignore block: [:c | nil ]) signal
]

"Internal condition: signaled by the commit continuation once the block's work
has resolved, carrying the block's result. Caught by the transaction's
HandlerContext to run the commit. Not an Error, so the Error handler ignores it."
Condition subclass: #OkToCommit
    instanceVariableNames: 'value'
    classVariableNames: ''
    indexedSlots: #none.

OkToCommit class >> value: v [ ^self _primNewValue: [:c | c pvtSetValue: v] ]
OkToCommit >> pvtSetValue: v [ value := v ]
OkToCommit >> value          [ ^value ]

"Returned by `Transaction atomic:`. `result` is a future that resolves with the
block's value on commit, or rejects on rollback."
Value subclass: #TxResult
    instanceVariableNames: 'transaction result'
    classVariableNames: ''
    indexedSlots: #none.

TxResult class >> transaction: t result: r [
    ^self _primNewValue: [:x | x pvtSetTransaction: t result: r]
]
TxResult >> pvtSetTransaction: t result: r [ transaction := t. result := r ]
TxResult >> transaction [ ^transaction ]
TxResult >> result      [ ^result ]
TxResult >> status      [ ^transaction status ]

"Participant-side trampoline: the coordinator sends pvtExitTx: to finalize each
participant's current transaction frame (#commit applies shadow writes to live
slots and hands the durable buffer up; #rollback discards both)."
Object >> pvtExitTx: outcome [ ^self _primExitTxMode: outcome ]

Object subclass: #Transaction
    instanceVariableNames: 'handle status'
    classVariableNames: ''
    indexedSlots: #none.

"Deadlock-detection timeout (ms): how long an entity may stay blocked on a lock
before the interpreter runs wait-for cycle detection (C31 S5c). Stored in the VM
(see _primSetDeadlockTimeoutMs:); default 500 ms. Lowered in tests for a fast,
deterministic check."
Transaction class >> deadlockTimeoutMs        [ ^self _primDeadlockTimeoutMs ]
Transaction class >> deadlockTimeoutMs: anInt [ ^self _primSetDeadlockTimeoutMs: anInt ]

Transaction class >> atomic: aBlock [
    ^self new pvtRunAtomic: aBlock
]

Transaction >> initialize  [ status := #pending ]
Transaction >> status      [ ^status ]
Transaction >> isCommitted [ ^status = #committed ]
Transaction >> isAborted   [ ^status = #aborted ]

Transaction >> pvtRunAtomic: aBlock [
    | txf |
    txf := Future new.
    handle := self _primBeginAtomicTx.
    "Both outcomes are handled by ONE HandlerContext (handler-bind), so the async
     commit runs without a synchronous unwinding `on:do:` blocking the coordinator.
     OkToCommit's handler can `resume:` the commit point; Error's handler catches
     both signalled conditions (`tx abort`) and raw rejections surfaced through the
     condition system — including a Deadlock the detector injects into a parked
     reply — because `force_value`/`then:orElse:` route async rejections through
     `signal_condition`. The work future's rejection arm re-raises (`orElse:
     #signal`) into this same chain, so the Error handler is the single visible
     place collecting the transaction's failure behavior."
    (((HandlerContext new
        on: OkToCommit do: [:c | self pvtCommit. txf resolveWith: c value. c resume: c value])
        on: Error do: [:e | self pvtRollback. txf rejectWith: e]))
      run: [ | f |
        f := aBlock value: self.
        f then: [:val | (OkToCommit value: val) signal ] orElse: #signal ].
    ^TxResult transaction: self result: txf
]

Transaction >> pvtCommit [
    (self _primEnrolledParticipants: handle) do: [:p | (p pvtExitTx: #commit) await].
    self _primCommitSharedTx: handle.
    status := #committed
]

Transaction >> pvtRollback [
    (self _primEnrolledParticipants: handle) do: [:p | (p pvtExitTx: #rollback) await].
    self _primRollbackSharedTx: handle.
    status := #aborted
]

"Abort from within the block: signals an Error caught by the HandlerContext,
which rolls back and rejects the result future."
Transaction >> abort [ self error: 'transaction aborted' ]

"════════════════════════════════════════════════════════════════════════════
 Optimistic multi-entity transactions — #stm (C32)

 `Transaction stm: aBlock` runs aBlock optimistically: participants are NOT
 locked during the block (unrelated handlers interleave freely), and each records
 the version it had when the transaction first touched it. At commit a two-phase
 protocol try-locks and validates every participant; if any version changed (a
 concurrent handler mutated it) or is already locked, the whole transaction
 aborts and retries (up to `stmRetryLimit` times). Exhausting the retries rejects
 the result future with a `TxConflict`.
 ════════════════════════════════════════════════════════════════════════════"

"Raised when an `#stm` transaction cannot commit within its retry budget because
a concurrent mutation kept invalidating its optimistic read/write set. Being an
Error, it surfaces when the result future is awaited."
Error subclass: #TxConflict
    instanceVariableNames: ''
    classVariableNames: ''
    indexedSlots: #none.

"Participant-side phase-1 trampoline: try-lock + validate this participant for the
tagged transaction, voting commit (true) / abort (false)."
Object >> pvtStmPrepare [ ^self _primStmPrepare ]

"How many times an #stm transaction re-runs its block before giving up. Override
in a subclass for a different budget."
Transaction class >> stmRetryLimit [ ^3 ]

Transaction class >> stm: aBlock [
    ^self new pvtRunStm: aBlock
]

Transaction >> pvtRunStm: aBlock [
    | txf |
    txf := Future new.
    self pvtStmAttempt: aBlock result: txf retriesLeft: self class stmRetryLimit.
    ^TxResult transaction: self result: txf
]

Transaction >> pvtMarkCommitted [ status := #committed ]
Transaction >> pvtMarkAborted   [ status := #aborted ]

"One optimistic attempt, structured exactly like `pvtRunAtomic` so `stm:` is
*non-blocking*: the block's work future is chained with `then:` (never awaited in
the coordinator), so `pvtStmAttempt:` returns immediately and the commit runs in
the continuation. When the work resolves, `OkToCommit` is signalled and its
HandlerContext handler runs the two-phase commit:
  - committed → resolve the result future;
  - version conflict → retry with a fresh snapshot while budget remains, else
    reject with `TxConflict`.
A raw Error (including `tx abort`, or a rejected participant reply surfaced while
awaiting) is caught by the outer unwinding `on: Error do:`, which rolls back and
rejects — errors are not retried. Retry re-enters `pvtStmAttempt:` (fresh STM
level + fresh `then:`) from within the handler; `resume: nil` then ends the
signalling continuation."
Transaction >> pvtStmAttempt: aBlock result: txf retriesLeft: n [
    handle := self _primBeginStmTx.
    (((HandlerContext new
        on: OkToCommit do: [:c |
            (self pvtStmCommit)
              ifTrue:  [ self pvtMarkCommitted. txf resolveWith: c value ]
              ifFalse: [ n > 0
                  ifTrue:  [ self pvtStmAttempt: aBlock result: txf retriesLeft: n - 1 ]
                  ifFalse: [ self pvtMarkAborted.
                             txf rejectWith: (TxConflict withMessage: 'stm: retries exhausted') ] ].
            c resume: c value ])
        on: Error do: [:e | self pvtStmRollback. self pvtMarkAborted. txf rejectWith: e]))
      run: [ | f |
        f := aBlock value: self.
        f then: [:val | (OkToCommit value: val) signal ] orElse: #signal ]
]

"Two-phase commit. Phase 1: prepare (try-lock + validate) every participant.
If all vote commit, phase 2 applies each participant's writes to live slots,
unlocks, and commits the shared store transaction (returns true). Otherwise every
participant is released and the shared transaction rolls back (returns false)."
Transaction >> pvtStmCommit [
    | participants allOk |
    participants := self _primEnrolledParticipants: handle.
    "Contagious-atomic: a requested #stm coerced to atomic (nested under an atomic
     ancestor) commits pessimistically — no version validation, just apply and
     commit, exactly like a nested atomic child. It can never conflict."
    (self _primTxIsStm: handle) ifFalse: [
        participants do: [:p | (p pvtExitTx: #commit) await].
        self _primCommitSharedTx: handle.
        ^true ].
    "Optimistic path: prepare (try-lock + validate) each participant, folding the
     votes. `and:` short-circuits, so once one votes abort we stop locking further."
    allOk := participants inject: true into: [:acc :p | acc and: [ (p pvtStmPrepare) await ]].
    allOk
        ifTrue: [
            participants do: [:p | (p pvtExitTx: #commit) await].
            self _primCommitSharedTx: handle.
            ^true ]
        ifFalse: [
            participants do: [:p | (p pvtExitTx: #rollback) await].
            self _primRollbackSharedTx: handle.
            ^false ]
]

"Error-path rollback: release every participant (discarding its shadow) and roll
back the shared transaction."
Transaction >> pvtStmRollback [
    (self _primEnrolledParticipants: handle) do: [:p | (p pvtExitTx: #rollback) await].
    self _primRollbackSharedTx: handle
]
